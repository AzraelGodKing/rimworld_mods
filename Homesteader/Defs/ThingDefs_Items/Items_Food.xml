<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Jerky ============ -->
  <ThingDef ParentName="ResourceBase">
    <defName>Homesteader_Jerky</defName>
    <label>jerky</label>
    <description>Strips of meat dried until tough and chewy. Keeps for two months and weighs almost nothing, making it ideal travel food and emergency rations.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Homesteader/Items/Jerky</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>0.018</Mass>
      <MarketValue>1.8</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Meal</foodType>
      <preferability>RawTasty</preferability>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>60</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>FoodMeals</li>
    </thingCategories>
  </ThingDef>

  <!-- ============ Dried produce ============ -->
  <ThingDef ParentName="ResourceBase">
    <defName>Homesteader_DriedProduce</defName>
    <label>dried produce</label>
    <description>Fruit and vegetables sliced thin and air-dried. Keeps for two months and is light enough to carry on long journeys.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Homesteader/Items/DriedProduce</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>0.015</Mass>
      <MarketValue>1.4</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Meal</foodType>
      <preferability>RawTasty</preferability>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>60</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>FoodMeals</li>
    </thingCategories>
  </ThingDef>

  <!-- ============ Smoked meat ============ -->
  <ThingDef ParentName="ResourceBase">
    <defName>Homesteader_SmokedMeat</defName>
    <label>smoked meat</label>
    <description>Meat cured in wood smoke. Keeps for around a month without refrigeration and can be cooked into meals just like raw meat. Unappetizing eaten on its own.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Homesteader/Items/SmokedMeat</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <DeteriorationRate>4</DeteriorationRate>
      <Mass>0.025</Mass>
      <MarketValue>1.2</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Meat</foodType>
      <preferability>RawBad</preferability>
      <tasteThought>AteRawFood</tasteThought>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>30</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>MeatRaw</li>
    </thingCategories>
  </ThingDef>

</Defs>
