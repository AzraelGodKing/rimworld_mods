<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThoughtDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Strata_DeepBedroom</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>Strata.ThoughtWorker_StrataDeepBedroom</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>deep impressive bedroom</label>
        <description>My bedroom is far below the surface, and it is genuinely impressive down here.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
      <li>
        <label>deep very impressive bedroom</label>
        <description>I sleep in a remarkable chamber carved from the living rock. Few nobles could match this.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>


  <!-- Mood bonus for colonists standing on an exposed upper roof deck. -->
  <ThoughtDef>
    <defName>Strata_UpperDeckView</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>Strata.ThoughtWorker_StrataUpperDeckView</workerClass>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>rooftop view</label>
        <description>I can see across the whole base from up here. There is something satisfying about looking down on everything.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Strata_Suffocation</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>Strata.ThoughtWorker_StrataSuffocation</workerClass>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>thin air</label>
        <description>The air down here feels thin. I need ventilation, plants, or an oxygen pump.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>suffocating</label>
        <description>I can barely catch my breath. This sealed chamber is running out of oxygen.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Strata_StuffyAir</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>Strata.ThoughtWorker_StrataStuffyAir</workerClass>
    <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>stuffy air</label>
        <description>The air is heavy with exhaled breath. We need a CO₂ scrubber or a way out.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
      <li>
        <label>choking on CO₂</label>
        <description>Carbon dioxide is pooling in this room. My head is pounding.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
