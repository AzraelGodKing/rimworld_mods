{"nodes": [{"id": "strata_steamdescription_strata", "label": "Strata (Workshop description)", "file_type": "document", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positioned as 'dig down, build up, one colony many floors' with Harmony required, Odyssey optional, mid-save safe, and explicitly not Multiplayer compatible."}, {"id": "strata_steamdescription_job_relay", "label": "Job relay treats the column as one settlement", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly contrasted with other multi-level mods that leave each floor an island: idle pawns notice work, food and beds across the stack so the player designates instead of micromanaging."}, {"id": "strata_steamdescription_see_below", "label": "See-below (look through sky holes and decks)", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "strata_steamdescription_cross_level_combat", "label": "Cross-level combat and auto-engage", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "strata_steamdescription_atmosphere_sim", "label": "Optional atmosphere simulation", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gases default off for performance; heat rises and cold pools through stairwells, buoyant gases rise and heavy gases sink, with pumps, scrubbers, exchangers, canary cages and a gas overlay as the player's tools."}, {"id": "strata_steamdescription_living_below", "label": "Living below research line", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "strata_steamdescription_shaft_power", "label": "Shaft power conduits and grid sharing", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live surplus feeds demand between floors so the player does not need a battery bank on every level."}, {"id": "strata_steamdescription_shaft_fluid_junctions", "label": "Soft fluid junctions", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bridges Dubs Bad Hygiene, Central Heating, Rimatomics, helixien gas, Vanilla Temperature ducts, chemfuel and crude oil only when those mods load, keeping the dependency soft."}, {"id": "strata_steamdescription_gravship_stacks", "label": "Gravship stacks (Odyssey)", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ship-only stairwells open A+/B+ pockets that travel on launch and reattach on landing; colony dig/tower stairs cannot sit on substructure, so ships need their own shaft type."}, {"id": "strata_steamdescription_direction_aware_events", "label": "Events that know which way is up", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sky threats stay on the surface while underground gets infestations, cave-ins, gas pockets, firestorms, deep sieges, breakthroughs and burrowing raiders, so depth changes the threat menu rather than just the map."}, {"id": "strata_steamdescription_incompatible_mods", "label": "Incompatible multi-level mods list", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AASB, AASB 2, MultiFloors, True Z-Levels, True Levels, Z-Levels and Pathfinding Avoidance all claim the same vertical/pathing space and must not run alongside Strata."}, {"id": "strata_steamdescription_performance_cost", "label": "Every level is a full map (performance cost)", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each opened floor costs real FPS on 300x300+ maps, so lightweight ticking, vacant-level and background throttles, 75%/50% new B levels, roof-sized decks and a default +-2 level cap are the mitigations."}, {"id": "strata_steamdescription_failsafe", "label": "Self-disabling system failsafe", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A repeatedly erroring Strata system switches itself off so the rest keeps running, and Mod options > Diagnostics shows what happened and can re-arm it."}, {"id": "strata_steamdescription_quest_map_warning", "label": "Do not dig shafts on temporary quest maps", "file_type": "concept", "source_file": "Strata/SteamDescription.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "strata_steamdescription_strata", "target": "strata_about_publishedfileid_strata_workshop_id", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "Strata/SteamDescription.txt", "source_location": null, "weight": 1.0}, {"source": "strata_steamdescri