<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Brew cider ============ -->
  <RecipeDef>
    <defName>Homesteader_BrewCider</defName>
    <label>brew cider</label>
    <description>Press and ferment raw fruit and vegetables into a small batch of cider.</description>
    <jobString>Brewing cider.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <Homesteader_Cider>5</Homesteader_Cider>
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

  <!-- ============ Brew mead ============ -->
  <RecipeDef>
    <defName>Homesteader_BrewMead</defName>
    <label>brew mead</label>
    <description>Ferment honey into strong, sweet mead.</description>
    <jobString>Brewing mead.</jobString>
    <workAmount>1400</workAmount>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_Honey</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Homesteader_Honey</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Homesteader_Mead>5</Homesteader_Mead>
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

  <!-- ============ Brew herbal tea ============ -->
  <RecipeDef>
    <defName>Homesteader_BrewHerbalTea</defName>
    <label>brew herbal tea</label>
    <description>Steep dried herbs into a batch of soothing herbal tea.</description>
    <jobString>Brewing herbal tea.</jobString>
    <workAmount>450</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_DriedHerbs</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Homesteader_DriedHerbs</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Homesteader_HerbalTea>3</Homesteader_HerbalTea>
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

</Defs>
