<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Log bench ============ -->
  <ThingDef ParentName="FurnitureWithQualityBase">
    <defName>Homesteader_LogBench</defName>
    <label>log bench</label>
    <description>A split-log bench with room for two. Simple, sturdy seating for the homestead porch or dining table.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/LogBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.3</fillPercent>
    <size>(2,1)</size>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>450</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
      <Comfort>0.55</Comfort>
    </statBases>
    <costList>
      <WoodLog>25</WoodLog>
    </costList>
    <socialPropernessMatters>true</socialPropernessMatters>
    <building>
      <isSittable>true</isSittable>
      <multiSittable>true</multiSittable>
    </building>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Rocking chair ============ -->
  <ThingDef ParentName="FurnitureWithQualityBase">
    <defName>Homesteader_RockingChair</defName>
    <label>rocking chair</label>
    <description>A hand-carved rocking chair. Exceptionally comfortable for long evenings by the hearth.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/RockingChair</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.35</fillPercent>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>5</Beauty>
      <Comfort>0.85</Comfort>
    </statBases>
    <costList>
      <WoodLog>45</WoodLog>
    </costList>
    <socialPropernessMatters>true</socialPropernessMatters>
    <building>
      <isSittable>true</isSittable>
    </building>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_HomesteadComforts</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Quilted bed ============ -->
  <ThingDef ParentName="BedWithQualityBase">
    <defName>Homesteader_QuiltedBed</defName>
    <label>quilted bed</label>
    <description>A wooden bed topped with a thick patchwork quilt. Warm, homey, and a little more comfortable than a standard bed.</description>
    <thingClass>Building_Bed</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/QuiltedBed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,2)</drawSize>
      <damageData>
        <rect>(0,0.05,1,1.95)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <size>(1,2)</size>
    <statBases>
      <MaxHitPoints>130</MaxHitPoints>
      <WorkToBuild>950</WorkToBuild>
      <Mass>32</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>3</Beauty>
      <BedRestEffectiveness>1.02</BedRestEffectiveness>
      <Comfort>0.82</Comfort>
    </statBases>
    <costList>
      <WoodLog>35</WoodLog>
      <Cloth>25</Cloth>
    </costList>
    <building>
      <bed_showSleeperBody>false</bed_showSleeperBody>
    </building>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_HomesteadComforts</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Diggo the plushie ============ -->
  <ThingDef ParentName="FurnitureWithQualityBase">
    <defName>Homesteader_DiggoPlushie</defName>
    <label>Diggo the plushie</label>
    <description>A hopelessly round plushie sewn in the shape of... nobody is quite sure. Part hippo, part dog, entirely chonky. Its stitched smile and button eyes make any room feel more like home, and colonists can flop down against its belly to snuggle away their worries.

Congrats to a dognamedKats for 1k followers!</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/HippoDogPlushie</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>10</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>1.5</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>20</Beauty>
      <Comfort>0.6</Comfort>
      <JoyGainFactor>1</JoyGainFactor>
    </statBases>
    <costList>
      <Cloth>30</Cloth>
    </costList>
    <building>
      <isSittable>true</isSittable>
      <joyKind>Meditative</joyKind>
      <watchBuildingStandDistanceRange>1~2</watchBuildingStandDistanceRange>
      <watchBuildingStandRectWidth>3</watchBuildingStandRectWidth>
      <watchBuildingInSameRoom>true</watchBuildingInSameRoom>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
    </building>
    <placeWorkers>
      <li>PlaceWorker_WatchArea</li>
    </placeWorkers>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Shark plushie ============ -->
  <ThingDef ParentName="FurnitureWithQualityBase">
    <defName>Homesteader_SharkPlushie</defName>
    <label>shark plushie</label>
    <description>A huggably round shark sewn from soft felt, with button eyes, stubby fins, and a mouthful of harmless fabric teeth. Sits happily in a corner looking menacing to absolutely no one. Colonists can flop against it to snuggle away their worries - Diggo's favorite ocean friend.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/SharkPlushie</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>10</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>1.5</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>20</Beauty>
      <Comfort>0.6</Comfort>
      <JoyGainFactor>1</JoyGainFactor>
    </statBases>
    <costList>
      <Cloth>30</Cloth>
    </costList>
    <building>
      <isSittable>true</isSittable>
      <joyKind>Meditative</joyKind>
      <watchBuildingStandDistanceRange>1~2</watchBuildingStandDistanceRange>
      <watchBuildingStandRectWidth>3</watchBuildingStandRectWidth>
      <watchBuildingInSameRoom>true</watchBuildingInSameRoom>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
    </building>
    <placeWorkers>
      <li>PlaceWorker_WatchArea</li>
    </placeWorkers>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ 27 statue ============ -->
  <ThingDef ParentName="FurnitureWithQualityBase">
    <defName>Homesteader_Statue27</defName>
    <label>27 statue</label>
    <description>A gilded numeral 27 mounted on a carved stone plinth, molten gold frozen mid-drip down its strokes. Nobody remembers exactly what the 27 commemorates, but it feels important.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/Statue27</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.4,1.4)</drawSize>
      <drawOffset>(0,0,0.25)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>18</Mass>
      <Flammability>0</Flammability>
      <Beauty>50</Beauty>
    </statBases>
    <costList>
      <Gold>15</Gold>
      <Steel>40</Steel>
    </costList>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Grand 27 statue ============ -->
  <ThingDef ParentName="FurnitureWithQualityBase">
    <defName>Homesteader_Statue27Grand</defName>
    <label>grand 27 statue</label>
    <description>A towering gilded 27 on a monumental stone plinth, gold dripping from every stroke. Whatever the 27 means, this version means it twice as hard.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/Statue27Grand</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.6,2.6)</drawSize>
      <drawOffset>(0,0,0.35)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>320</MaxHitPoints>
      <WorkToBuild>18000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0</Flammability>
      <Beauty>125</Beauty>
    </statBases>
    <costList>
      <Gold>40</Gold>
      <Steel>100</Steel>
    </costList>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Oil lamp ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_OilLamp</defName>
    <label>oil lamp</label>
    <description>A brass oil lamp that burns chemfuel for warm, steady light. No power grid required.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/OilLamp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <fillPercent>0.2</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToBuild>300</WorkToBuild>
      <Mass>3</Mass>
      <Flammability>0.8</Flammability>
      <Beauty>3</Beauty>
    </statBases>
    <costList>
      <Steel>15</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.5</fuelConsumptionRate>
        <fuelCapacity>10.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
      <li Class="CompProperties_FireOverlay">
        <fireSize>0.2</fireSize>
        <offset>(0,0,0.15)</offset>
      </li>
    </comps>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_HomesteadComforts</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Wood stove ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_WoodStove</defName>
    <label>wood stove</label>
    <description>A cast-iron stove that burns wood to heat a room. Slower to warm up than an electric heater, but works entirely off-grid.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/WoodStove</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1100</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0.3</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <Steel>40</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>2.5</fuelConsumptionRate>
        <fuelCapacity>40.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_HeatPusher">
        <heatPerSecond>18</heatPerSecond>
        <heatPushMaxTemperature>30</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(252,160,80,0)</glowColor>
      </li>
      <li Class="CompProperties_FireOverlay">
        <fireSize>0.3</fireSize>
        <offset>(0,0,0.05)</offset>
      </li>
    </comps>
    <designationCategory>Temperature</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsTemperature</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_HomesteadComforts</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
