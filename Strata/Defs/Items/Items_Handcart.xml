<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>Strata_Handcart</defName>
    <label>handcart</label>
    <description>A two-wheel cart you keep on a hauler. They take more in one trip and they walk like it. It goes through stairs and elevators because it is inventory, not a vehicle.</description>
    <graphicData>
      <texPath>Strata/Buildings/CargoLift</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.85,0.85)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>90</MarketValue>
      <Mass>12</Mass>
      <Flammability>0.8</Flammability>
      <WorkToMake>2000</WorkToMake>
    </statBases>
    <stackLimit>1</stackLimit>
    <thingCategories>
      <li>Items</li>
    </thingCategories>
    <costList>
      <WoodLog>40</WoodLog>
      <Steel>20</Steel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>Strata_Sledge</defName>
    <label>sledge</label>
    <description>A winter sledge. More than a handcart will hold, slower than a handcart will walk. Still just an item — it rides the elevator in someone's pack.</description>
    <graphicData>
      <texPath>Strata/Buildings/CargoLift</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.95,0.95)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>110</MarketValue>
      <Mass>16</Mass>
      <Flammability>0.7</Flammability>
      <WorkToMake>2400</WorkToMake>
    </statBases>
    <stackLimit>1</stackLimit>
    <thingCategories>
      <li>Items</li>
    </thingCategories>
    <costList>
      <WoodLog>50</WoodLog>
      <Steel>15</Steel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>
</Defs>
