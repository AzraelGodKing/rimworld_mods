<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Storage crate ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_StorageCrate</defName>
    <label>storage crate</label>
    <description>A sturdy wooden crate that holds up to three stacks of items. Its lid keeps the contents from deteriorating, even outdoors.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/StorageCrate</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.45</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>450</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>35</WoodLog>
    </costList>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <maxItemsInCell>3</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>Root</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <categories>
            <li>Root</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Furniture</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Storage barrel ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_StorageBarrel</defName>
    <label>storage barrel</label>
    <description>A lidded wooden barrel for storing food and drink. Holds up to three stacks and keeps them from deteriorating in the weather. It cannot slow spoilage - keep perishables cool or preserve them first.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/StorageBarrel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.45</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Mass>7</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>30</WoodLog>
    </costList>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <maxItemsInCell>3</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>Foods</li>
            <li>Drugs</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <categories>
            <li>Foods</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Furniture</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Pallet ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_Pallet</defName>
    <label>pallet</label>
    <description>A simple wooden pallet that keeps two stacks of goods off the ground, protecting them from deterioration. Cheap enough to line an entire yard with. Can hold anything, including stone chunks.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/Pallet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>10</pathCost>
    <fillPercent>0.10</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Mass>4</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>15</WoodLog>
    </costList>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <maxItemsInCell>2</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>Root</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Low</priority>
        <filter>
          <categories>
            <li>Root</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Furniture</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

</Defs>
