<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Odyssey-only: shaft into a Strata pocket under the gravship. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_GravshipStairsDown</defName>
    <label>gravship stairwell</label>
    <description>A compact shaft cut through the gravship deck into a Strata level below. Only placeable on gravship substructure. Linked floors travel with the ship on launch and reattach on landing.\n\nRequires digging down research. A second gravship stairwell joins the same deck below.</description>
    <thingClass>Strata.Building_GravshipStairsDown</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/StairsDown</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <color>(0.55, 0.75, 0.95)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <portal>
      <pocketMapGenerator>Strata_UndergroundLevel</pocketMapGenerator>
      <exitDef>Strata_GravshipStairsUp</exitDef>
      <pocketMapSize>200</pocketMapSize>
    </portal>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <placeWorkers>
      <li>Strata.PlaceWorker_GravshipStairwell</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
        <basePowerConsumption>0</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="Strata.CompProperties_StairwellControl"/>
    </comps>
    <researchPrerequisites>
      <li>Strata_DiggingDown</li>
    </researchPrerequisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_GravshipStairsUp</defName>
    <label>gravship stairwell up</label>
    <description>The landing below a gravship stairwell — climb back up to the ship deck. Cannot be deconstructed.</description>
    <thingClass>Strata.Building_GravshipStairsUp</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/StairsUp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <color>(0.55, 0.75, 0.95)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
        <basePowerConsumption>0</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

