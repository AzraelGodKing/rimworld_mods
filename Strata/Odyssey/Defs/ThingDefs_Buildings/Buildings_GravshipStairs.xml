    </researchPrerequisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_GravshipBuildUpLanding</defName>
    <label>gravship tower landing</label>
    <description>Upper landing of a gravship tower stairwell — climb back down to the ship. Cannot be deconstructed.</description>
    <thingClass>Strata.Building_GravshipBuildUpLanding</thingClass>
    <graphicData>
