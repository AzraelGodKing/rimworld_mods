<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ScenarioDef>
    <defName>Homesteader_Homesteaders</defName>
    <label>Homesteaders</label>
    <description>Three settlers strike out to build a self-sufficient farmstead far from civilization. No fancy technology - just livestock, seed grain, hand tools, and the knowledge to live off the land.\n\nLocks the Azrael storyteller (ships with Homesteader).</description>
    <scenario>
      <summary>Three homesteaders under Azrael. Livestock, seed, and grit.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>

        <li Class="Homesteader.ScenPart_ForcedStoryteller">
          <def>Homesteader_ForcedStoryteller</def>
          <storyteller>Azrael</storyteller>
        </li>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>3</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The wagon is unloaded and the ground is yours to work.

There is grain to sow, animals to tend, and a long winter somewhere beyond the horizon.

Build a homestead that can outlast it all.</text>
          <closeSound>GameStartSting</closeSound>
        </li>

        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>Homesteader_PrimitiveHomestead</project>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>300</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>WoodLog</thingDef>
          <count>350</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Pemmican</thingDef>
          <count>120</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>16</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Homesteader_RockSalt</thingDef>
          <count>30</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Bow_Short</thingDef>
          <count>2</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Knife</thingDef>
          <stuff>Steel</stuff>
          <count>1</count>
        </li>

        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <animalKind>Cow</animalKind>
          <count>1</count>
        </li>

        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <animalKind>Chicken</animalKind>
          <count>3</count>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
