<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Mill flour ============ -->
  <RecipeDef>
    <defName>Homesteader_MillFlour</defName>
    <label>mill flour</label>
    <description>Grind raw plants and grain into flour.</description>
    <jobString>Milling flour.</jobString>
    <workAmount>700</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
          <disallowedThingDefs>
            <li>Hay</li>
            <li>RawFungus</li>
          </disallowedThingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
      <disallowedThingDefs>
        <li>Hay</li>
        <li>RawFungus</li>
      </disallowedThingDefs>
    </fixedIngredientFilter>
    <products>
      <Homesteader_Flour>10</Homesteader_Flour>
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

