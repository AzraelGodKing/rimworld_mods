<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ DEPRECATED cargo lift (save-compat stub only) ============ -->
  <!-- Not buildable (no designationCategory). Exists so saves made while the
       cargo lift still existed load without errors; deconstruct any leftovers. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_CargoLift</defName>
    <label>cargo lift (deprecated)</label>
    <description>This building has been removed from Strata. Deconstruct it - haulers plus a stockpile by the stairs move goods between levels now.</description>
    <thingClass>Strata.Building_CargoLift</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/CargoLift</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0.4</Flammability>
    </statBases>
    <canOverlapZones>false</canOverlapZones>
  </ThingDef>

  <!-- ============ Tower stairwell (up from surface / A-n) ============ -->
  <ThingDef ParentName="Strata_HandrailStairsUpGraphic">
    <defName>Strata_StairsBuildUp</defName>
    <label>tower stairwell</label>
    <description>A stair tower that opens a new outdoor floor above this map. Completing it frames Level +1 (or joins an upper floor already opened by another tower stairwell). The upper map is a roof deck: you can only walk and build where this floor is roofed, plus a plaza around the shaft — open sky beyond the roof edge cannot hold structures. Expand roofs downstairs to grow the deck. Requires building up research.

Colonists use the tower on their own to work across floors. Wire each level into the stairwell to pool power. It cannot be deconstructed while anyone is still above.</description>
    <thingClass>Strata.Building_StairsBuildUp</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <WoodLog>80</WoodLog>
      <Steel>40</Steel>
    </costList>
    <portal>
      <pocketMapGenerator>Strata_UpperLevel</pocketMapGenerator>
      <exitDef>Strata_BuildUpLanding</exitDef>
      <pocketMapSize>200</pocketMapSize>
    </portal>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <placeWorkers>
      <li>Strata.PlaceWorker_LevelBuildUp</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
        <basePowerConsumption>0</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="Strata.CompProperties_StairwellControl"/>
    </comps>
    <researchPrerequisites>
      <li>Strata_BuildingUp</li>
    </researchPrerequisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- Landing on an upper floor — climb back down to the level below. -->
  <ThingDef ParentName="Strata_HandrailStairsDownGraphic">
    <defName>Strata_BuildUpLanding</defName>
    <label>tower landing</label>
    <description>The upper landing of a tower stairwell — stairs leading back down to the floor below. Wire this floor into the stairwell so power can pool with the level beneath. It cannot be deconstructed; it is the way down.</description>
    <thingClass>Strata.Building_BuildUpLanding</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
        <basePowerConsumption>0</basePowerConsumption>
