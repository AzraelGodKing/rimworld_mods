  <!-- ============ Canned stew ============ -->
  <ThingDef ParentName="MealBase">
    <defName>Homesteader_CannedStew</defName>
    <label>canned stew</label>
    <description>Hearty stew sealed in a mason jar. Keeps for years on the shelf - the homestead answer to emergency rations.</description>
    <graphicData>
      <texPath>Homesteader/Items/CannedStew</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>16</MarketValue>
      <Mass>0.35</Mass>
      <Nutrition>0.9</Nutrition>
      <FoodPoisonChanceFixedHuman>0.005</FoodPoisonChanceFixedHuman>
    </statBases>
    <ingestible>
      <foodType>Meal</foodType>
      <preferability>MealFine</preferability>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <tasteThought>Homesteader_AteHomesteadTreat</tasteThought>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>720</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
