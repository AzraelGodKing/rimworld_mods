<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Bake pumpkin pie ============ -->
  <RecipeDef>
    <defName>Homesteader_BakePumpkinPie</defName>
    <label>bake pumpkin pie</label>
    <description>Bake a sweet pumpkin pie from mash, flour, butter, and a sweetener.</description>
    <jobString>Baking pumpkin pie.</jobString>
    <workAmount>900</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_RawPumpkin</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_Flour</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_Butter</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_Sugar</li>
            <li>Homesteader_Honey</li>
            <li>Homesteader_MapleSyrup</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Homesteader_RawPumpkin</li>
        <li>Homesteader_Flour</li>
        <li>Homesteader_Butter</li>
        <li>Homesteader_Sugar</li>
        <li>Homesteader_Honey</li>
        <li>Homesteader_MapleSyrup</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Homesteader_PumpkinPie>1</Homesteader_PumpkinPie>
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

  <!-- ============ Bake buttermilk biscuits ============ -->
  <RecipeDef>
    <defName>Homesteader_BakeButtermilkBiscuits</defName>
    <label>bake buttermilk biscuits</label>
    <description>Bake soft biscuits from flour, buttermilk, and butter.</description>
    <jobString>Baking buttermilk biscuits.</jobString>
    <workAmount>700</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_Flour</li>
          </thingDefs>
        </filter>
        <count>6</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_Buttermilk</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_Butter</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Homesteader_Flour</li>
        <li>Homesteader_Buttermilk</li>
        <li>Homesteader_Butter</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Homesteader_ButtermilkBiscuits>2</Homesteader_ButtermilkBiscuits>
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

  <!-- ============ Brew cider vinegar ============ -->
  <RecipeDef>
    <defName>Homesteader_BrewCiderVinegar</defName>
    <label>brew cider vinegar</label>
    <description>Let cider sour into sharp cider vinegar for pickling and cooking.</description>
    <jobString>Brewing cider vinegar.</jobString>
    <workAmount>1000</workAmount>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_Cider</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Homesteader_Cider</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Homesteader_CiderVinegar>8</Homesteader_CiderVinegar>
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

  <!-- ============ Brew apple cider ============ -->
  <RecipeDef>
    <defName>Homesteader_BrewAppleCider</defName>
    <label>brew apple cider</label>
    <description>Press orchard apples with a sweetener into a proper apple cider — no barley mash pretending to be fruit.</description>
    <jobString>Brewing apple cider.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_RawApples</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_Sugar</li>
            <li>Homesteader_Honey</li>
            <li>Homesteader_MapleSyrup</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Homesteader_RawApples</li>
        <li>Homesteader_Sugar</li>
        <li>Homesteader_Honey</li>
        <li>Homesteader_MapleSyrup</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Homesteader_Cider>6</Homesteader_Cider>
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

  <!-- ============ Vinegar pickles ============ -->
  <RecipeDef>
    <defName>Homesteader_MakeVinegarPickles</defName>
    <label>make vinegar pickles</label>
    <description>Pack vegetables in cider vinegar for a sharper, longer-keeping pickle than salt brine alone.</description>
    <jobString>Making vinegar pickles.</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
          <disallowedThingDefs>
            <li>Hay</li>
            <li>RawFungus</li>
          </disallowedThingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Homesteader_CiderVinegar</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
      <thingDefs>
        <li>Homesteader_CiderVinegar</li>
      </thingDefs>
      <disallowedThingDefs>
        <li>Hay</li>
        <li>RawFungus</li>
      </disallowedThingDefs>
    </fixedIngredientFilter>
    <products>
      <Homesteader_PickledVegetables>12</Homesteader_PickledVegetables>
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

