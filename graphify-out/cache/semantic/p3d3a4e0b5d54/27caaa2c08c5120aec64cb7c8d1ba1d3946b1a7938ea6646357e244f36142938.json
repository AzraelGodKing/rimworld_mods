{"nodes": [{"id": "docs_release_release_and_publish", "label": "Release & Publish workflow", "file_type": "document", "source_file": "docs/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mirrors the Sunhaven workflow: dispatch, validate, build, pack a Workshop-safe zip via git archive plus DLL with export-ignore keeping Source and refresh art out, then publish to the selected channels."}, {"id": "docs_release_github_release", "label": "GitHub Release channel", "file_type": "concept", "source_file": "docs/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tags {ZipName}-v{modVersion} and deliberately does not move the rolling latest tag the docs site depends on."}, {"id": "docs_release_nexus_upload", "label": "Nexus Mods upload", "file_type": "concept", "source_file": "docs/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Nexus-Mods/upload-action pinned to a commit because there is no v1 tag; the changelog POST runs only after the file upload succeeds so a changelog failure never re-uploads the zip."}, {"id": "docs_release_mods_website", "label": "Mods website download channel", "file_type": "concept", "source_file": "docs/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs Cloudflare secrets; if they are missing GitHub and Nexus still run and the website file is left alone rather than replaced."}, {"id": "docs_release_downloads_json_retry", "label": "downloads.json read-back retry (AZR-453)", "file_type": "rationale", "source_file": "docs/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrent releases each rewrite downloads.json, so the script re-reads after a pause and rewrites its entry until it sticks; an unreadable file is left alone instead of being replaced."}, {"id": "docs_release_version_gate", "label": "Version gate", "file_type": "concept", "source_file": "docs/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compares About.xml modVersion against the GitHub tag and the Nexus page/file version so a real run never rebuilds or re-uploads a mod with nothing to ship; GitHub and Nexus are independent, and release_anyway ignores both."}, {"id": "docs_release_mod_matrix", "label": "mod-matrix.json and Nexus IDs", "file_type": "concept", "source_file": "docs/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nexus cannot create a mod page from CI, so the page must exist with one manual upload before file id and mod id are pasted into the matrix row; nexus_publish false keeps IDs but skips upload and the gate."}, {"id": "docs_release_validate_mods", "label": "scripts/validate_mods.py", "file_type": "concept", "source_file": "docs/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_release_rollback", "label": "Rollback snapshots", "file_type": "concept", "source_file": "docs/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build mod DLLs force-moves latest for stable site buttons, and each run also cuts an immutable downloads-YYYY-MM-DD-<sha7> prerelease so players can roll back after a bad latest rebuild."}, {"id": "docs_release_azrael_unpublished", "label": "Azrael kept unpublished in the matrix", "file_type": "rationale", "source_file": "docs/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "publish false keeps Azrael in-repo and out of Release & Publish, the latest zips and the public hub, while CI still compiles it so the code does not rot."}, {"id": "docs_release_local_pack_check", "label": "Local pack check (pack_mod.sh / release_meta.py)", "file_type": "concept", "source_file": "docs/RELEASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_release_release_and_publish", "target": "docs_versioning_modversion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_release_release_and_publish", "target": "docs_release_github_release", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_release_release_and_publish", "target": "docs_release_nexus_upload", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_release_release_and_publish", "target": "docs_release_mods_website", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_release_release_and_publish", "target": "docs_release_version_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_release_release_and_publish", "target": "docs_release_validate_mods", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE.md", "source_location": null, "weight": 1.0}, {"source": "docs_release_mods_website", "target": "docs_release_downloads_json_retry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0,