        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Strata_ShaftFluid_Omni"]/comps</xpath>
          <value>
            <li Class="Rimefeller.CompProperties_Pipe">
              <mode>Crude</mode>
            </li>
            <li Class="Rimefeller.CompProperties_Pipe">
              <mode>Fuel</mode>
            </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>VanillaExpanded.VChemfuelE</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Strata_ShaftFluid_VefChemfuel"]/comps</xpath>
          <value>
            <li Class="PipeSystem.CompProperties_Resource">
              <pipeNet>VCHE_ChemfuelNet</pipeNet>
