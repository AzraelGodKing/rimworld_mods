<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Common\Azrael.Common.props" />
  <ItemGroup>
    <!-- Stormproof compat client: only the mods that read Stormproof link it. -->
    <Compile Include="..\..\Common\Sibling\StormproofClient.cs" Link="Common\StormproofClient.cs" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Strata</RootNamespace>
    <AssemblyName>Strata</AssemblyName>
    <!-- Unstable 1.7. Same 1.6 refs until a 1.7-only API change needs new references.
         Build this project for 1.7. Building Strata.csproj does not overwrite this DLL. -->
    <OutputPath>../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4998-unstable" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.4" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
