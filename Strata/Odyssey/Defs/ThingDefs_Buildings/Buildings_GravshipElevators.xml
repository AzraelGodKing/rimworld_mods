    <bringAlongOnGravship>true</bringAlongOnGravship>
    <graphicData>
      <texPath>Strata/Buildings/ElevatorUp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <color>(0.55, 0.85, 0.75)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <statBases>
      <WorkToBuild>9000</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <portal>
      <pocketMapGenerator>Strata_UpperLevel</pocketMapGenerator>
      <exitDef>Strata_GravshipElevatorBuildUpLanding</exitDef>
      <pocketMapSize>200</pocketMapSize>
    </portal>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
