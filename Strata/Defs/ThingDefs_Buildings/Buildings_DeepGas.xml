<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_GasVent</defName>
    <label>natural gas vent</label>
    <description>A pressurized crack in the rock venting natural gas from a deep pocket. Build a gas well here to harvest it, or vent the room and leave it alone.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Natural/SteamGeyser</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.05</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <deconstructible>false</deconstructible>
    </building>
    <comps>
      <li Class="Strata.CompProperties_DeepGasVent"/>
    </comps>
    <selectable>true</selectable>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_GasWell</defName>
    <label>deep gas well</label>
    <description>Harvests natural gas from a vent breached in the deep rock. Stores gas locally for a deep gas generator, or feeds helixien pipes when VHGE is loaded.</description>
    <thingClass>Strata.Building_GasWell</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/ShaftConduit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.3</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <designationCategory>Power</designationCategory>
    <researchPrerequisites>
      <li>Strata_DeepGasExtraction</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>Strata.PlaceWorker_GasWell</li>
    </placeWorkers>
    <comps>
      <li Class="Strata.CompProperties_DeepGasWell"/>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_DeepGasGenerator</defName>
    <label>deep gas generator</label>
    <description>Burns natural gas harvested from a nearby deep gas well. Self-contained power for levels without surface infrastructure.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Power/WoodFiredGenerator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>2800</WorkToBuild>
      <Flammability>0.8</Flammability>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <designationCategory>Power</designationCategory>
    <researchPrerequisites>
      <li>Strata_DeepGasExtraction</li>
    </researchPrerequisites>
    <comps>
      <li Class="Strata.CompProperties_DeepGasGenerator"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>-800</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
  </ThingDef>

</Defs>
