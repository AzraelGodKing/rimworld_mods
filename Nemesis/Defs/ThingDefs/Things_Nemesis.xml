<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>Nemesis_CallingCard</defName>
    <label>calling card</label>
    <description>A scrap of paper, cloth, or bone marked with a personal message. Someone wanted you to know they were here.</description>
    <graphicData>
      <!-- Core resource path (Harddrive is not a confirmed Core texture). Cloth matches "scrap of cloth". -->
      <texPath>Things/Item/Resource/Cloth</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.6</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>20</MaxHitPoints>
      <MarketValue>5</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <thingCategories>
      <li>Items</li>
    </thingCategories>
    <stackLimit>1</stackLimit>
    <tradeability>None</tradeability>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Nemesis_UseLabel_CallingCard</useLabel>
        <compClass>CompUsable</compClass>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>Nemesis.CompUseEffect_NemesisNote</compClass>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>Nemesis_Journal</defName>
    <label>nemesis journal</label>
    <description>A battered notebook filled with obsessive notes about a colony and a single person. Reading it feels like being watched.</description>
    <graphicData>
      <!-- Core Graphic_Single path. Textbook book textures are multi-dir; avoid pink squares. -->
      <texPath>Things/Item/Resource/ComponentIndustrial</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <MarketValue>40</MarketValue>
      <Mass>0.3</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <thingCategories>
      <li>Items</li>
    </thingCategories>
    <stackLimit>1</stackLimit>
    <tradeability>None</tradeability>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Nemesis_UseLabel_Journal</useLabel>
        <compClass>CompUsable</compClass>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>Nemesis.CompUseEffect_NemesisNote</compClass>
      </li>
    </comps>
  </ThingDef>

</Defs>
