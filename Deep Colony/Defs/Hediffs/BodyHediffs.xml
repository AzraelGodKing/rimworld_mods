<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>DC_Hediff_Convalescence</defName>
    <label>convalescence</label>
    <description>Still recovering. Light duty — drafting too soon risks a relapse later.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="DeepColony.HediffCompProperties_LeaveChronic"/>
    </comps>
    <stages>
      <li>
        <label>convalescing</label>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.08</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.06</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DC_Hediff_LingeringWeakness</defName>
    <label>lingering weakness</label>
    <description>The illness is gone; the body is not fully back. Managed, not cured — rest and an infirmary help.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <chronic>true</chronic>
    <initialSeverity>0.35</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>lingering</label>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.04</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.03</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
