  </ThingDef>

  <!-- ============ CO₂ pump (life support) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_CO2Pump</defName>
    <label>CO₂ pump</label>
    <description>A powered scrubber that pulls carbon dioxide out of the air in a sealed room and traps it in chemical filters. Pairs with an oxygen pump or shaft ventilation to keep deep workspaces breathable — colonists exhale faster than one unit can scrub, so busy rooms need more than one.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/CO2Pump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
