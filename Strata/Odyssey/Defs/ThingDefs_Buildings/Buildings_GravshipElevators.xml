    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <placeWorkers>
      <li>Strata.PlaceWorker_GravshipStairwell</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Strata_BuildingUp</li>
      <li>Strata_Elevators</li>
    </researchPrerequisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_GravshipElevatorBuildUpLanding</defName>
    <label>gravship tower elevator landing</label>
    <description>Upper landing of a gravship tower elevator — ride back down to the ship. Cannot be deconstructed. Descending works even without power.</description>
    <thingClass>Strata.Building_GravshipElevatorBuildUpLanding</thingClass>
    <graphicData>
