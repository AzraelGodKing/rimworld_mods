<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Excavated stairwell (down) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_StairsDown</defName>
    <label>excavated stairwell</label>
    <description>A broad staircase carved down into the rock beneath the colony. Completing it opens a new underground level: a solid stratum of stone that can be mined out into rooms, workshops, and vaults.

Colonists will use the stairwell on their own to work, eat, and sleep across levels. It cannot be deconstructed while anyone is still below.</description>
    <thingClass>Strata.Building_StairsDown</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/StairsDown</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <WoodLog>60</WoodLog>
      <Steel>30</Steel>
    </costList>
    <portal>
      <pocketMapGenerator>Strata_UndergroundLevel</pocketMapGenerator>
      <exitDef>Strata_StairsUp</exitDef>
      <pocketMapSize>75</pocketMapSize>
    </portal>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <comps>
      <li Class="Strata.CompProperties_StairwellControl"/>
    </comps>
    <researchPrerequisites>
      <li>Strata_Excavation</li>
    </researchPrerequisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- ============ Cargo lift ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_CargoLift</defName>
    <label>cargo lift</label>
    <description>A powered freight hoist. Built beside a stairwell, it automatically moves loose items between this level and the linked one - no colonist required. Toggle whether it hoists goods up to this level or sends them down. Needs power to run.</description>
    <thingClass>Strata.Building_CargoLift</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/CargoLift</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Strata_Excavation</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Stairwell up (spawned at the bottom of the stairs) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_StairsUp</defName>
    <label>stairwell up</label>
    <description>The bottom landing of an excavated stairwell, leading back up to the level above. It cannot be deconstructed - it is the way home.</description>
    <thingClass>Strata.Building_StairsUp</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/StairsUp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

</Defs>
