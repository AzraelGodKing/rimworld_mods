<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Drying rack ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_DryingRack</defName>
    <label>drying rack</label>
    <description>A wooden rack for air-drying food. Raw meat can be dried into long-lasting jerky, and fruit or vegetables into dried produce. Requires no power or research.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/DryingRack</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <size>(3,1)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>18</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>60</WoodLog>
    </costList>
    <recipes>
      <li>Homesteader_MakeJerky</li>
      <li>Homesteader_MakeDriedProduce</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Smokehouse ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_Smokehouse</defName>
    <label>smokehouse</label>
    <description>A wood-fired smoker. Raw meat smoked here keeps for around a month and can still be cooked into meals. Consumes wood as fuel while in use.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/Smokehouse</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.6</fillPercent>
    <rotatable>true</rotatable>
    <size>(3,1)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>1600</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <costList>
      <WoodLog>90</WoodLog>
      <Steel>20</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>40.0</fuelConsumptionRate>
        <fuelCapacity>30.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
    </comps>
    <recipes>
      <li>Homesteader_SmokeMeat</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

</Defs>
