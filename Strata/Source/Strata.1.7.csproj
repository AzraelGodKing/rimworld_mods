<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Common\Azrael.Common.props" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Strata</RootNamespace>
    <AssemblyName>Strata</AssemblyName>
    <!-- Unstable 1.7. Same 1.6 refs until a 1.7-only API change needs new references.
         Build this project for 1.7. Building Strata.csproj does not overwrite this DLL. -->
    <OutputPath>../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.3.*" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
