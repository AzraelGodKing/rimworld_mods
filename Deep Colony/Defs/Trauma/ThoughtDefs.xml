<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ── Shared base ────────────────────────────────────────────────────────── -->
  <ThoughtDef Name="DC_TraumaThoughtBase" Abstract="True">
    <thoughtClass>DeepColony.Thought_Trauma</thoughtClass>
    <stackLimit>1</stackLimit>
    <lerpMoodToZero>true</lerpMoodToZero>
    <durationDays>30</durationDays>
  </ThoughtDef>

  <!-- ═══════════════════════════════════════════════════════════════════
       COMBAT SHOCK (downed in battle)
       Raw: -12, Processing: -8, Fading: -4
  ══════════════════════════════════════════════════════════════════════ -->
  <ThoughtDef ParentName="DC_TraumaThoughtBase">
    <defName>DC_Thought_CombatShock</defName>
    <label>combat shock</label>
    <stages>
      <li>
        <label>flashbacks (raw)</label>
        <description>Vivid flashbacks to the moment of being struck down in battle.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
      <li>
        <label>processing trauma</label>
        <description>Still working through the shock of being downed in combat.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>fading memories</label>
        <description>The worst memories of combat are slowly fading.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ═══════════════════════════════════════════════════════════════════
       VIOLENT LOSS (witnessed close companion die)
  ══════════════════════════════════════════════════════════════════════ -->
  <ThoughtDef ParentName="DC_TraumaThoughtBase">
    <defName>DC_Thought_ViolentLoss</defName>
    <label>violent loss</label>
    <durationDays>45</durationDays>
    <stages>
      <li>
        <label>haunted by {0}'s death</label>
        <description>Cannot stop seeing it happen. The violence of it refuses to leave.</description>
        <baseMoodEffect>-12</baseMoodEffect>
      </li>
      <li>
        <label>grieving {0}</label>
        <description>Still coming to terms with the loss of someone close.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
      <li>
        <label>remembering {0}</label>
        <description>The grief is softening, but the memory lingers.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ═══════════════════════════════════════════════════════════════════
       CAPTIVITY TRAUMA
  ══════════════════════════════════════════════════════════════════════ -->
  <ThoughtDef ParentName="DC_TraumaThoughtBase">
    <defName>DC_Thought_Captivity</defName>
    <label>captivity trauma</label>
    <durationDays>60</durationDays>
    <stages>
      <li>
        <label>reliving captivity</label>
        <description>Reliving every detail of captivity in waking nightmares.</description>
        <baseMoodEffect>-18</baseMoodEffect>
      </li>
      <li>
        <label>haunted by captivity</label>
        <description>The fear and helplessness of captivity still press in.</description>
        <baseMoodEffect>-12</baseMoodEffect>
      </li>
      <li>
        <label>distant memories of captivity</label>
        <description>Captivity feels like a long time ago now, though the scars remain.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ═══════════════════════════════════════════════════════════════════
       MASSACRE SURVIVOR
  ══════════════════════════════════════════════════════════════════════ -->
  <ThoughtDef ParentName="DC_TraumaThoughtBase">
    <defName>DC_Thought_Massacre</defName>
    <label>massacre survivor</label>
    <durationDays>50</durationDays>
    <stages>
      <li>
        <label>survivor's guilt</label>
        <description>Why did they survive when so many others did not?</description>
        <baseMoodEffect>-14</baseMoodEffect>
      </li>
      <li>
        <label>coming to terms with the massacre</label>
        <description>Slowly making peace with surviving something so terrible.</description>
        <baseMoodEffect>-9</baseMoodEffect>
      </li>
      <li>
        <label>at peace with the past</label>
        <description>The massacre is in the past. They carry those lost with them.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ═══════════════════════════════════════════════════════════════════
       BEREAVEMENT SHOCK (multiple losses in rapid succession)
  ══════════════════════════════════════════════════════════════════════ -->
  <ThoughtDef ParentName="DC_TraumaThoughtBase">
    <defName>DC_Thought_BereavementShock</defName>
    <label>bereavement shock</label>
    <durationDays>40</durationDays>
    <stages>
      <li>
        <label>reeling from loss</label>
        <description>Too many people gone too fast. The grief hasn't caught up yet.</description>
        <baseMoodEffect>-16</baseMoodEffect>
      </li>
      <li>
        <label>grieving multiple losses</label>
        <description>Carrying the weight of losing several companions in a short time.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
      <li>
        <label>slowly healing</label>
        <description>The worst of the grief is passing, leaving a quieter sadness.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="DC_TraumaThoughtBase">
    <defName>DC_Thought_FireTrauma</defName>
    <label>fire trauma</label>
    <durationDays>35</durationDays>
    <stages>
      <li>
        <label>terrified of fire</label>
        <description>Every spark feels like the blaze that nearly took them.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
      <li>
        <label>uneasy around flame</label>
        <description>Still flinches near open fire.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
      <li>
        <label>fire memories fading</label>
        <description>The burns healed; the fear is quieter now.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="DC_TraumaThoughtBase">
    <defName>DC_Thought_ToxicTrauma</defName>
    <label>toxic trauma</label>
    <durationDays>40</durationDays>
    <stages>
      <li>
        <label>poison panic</label>
        <description>Cannot shake the feeling of toxins in their blood.</description>
        <baseMoodEffect>-11</baseMoodEffect>
      </li>
      <li>
        <label>wary of contamination</label>
        <description>Suspicious of air, water, and unexplained smells.</description>
        <baseMoodEffect>-7</baseMoodEffect>
      </li>
      <li>
        <label>toxic memories fading</label>
        <description>The poisoning feels more distant.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="DC_TraumaThoughtBase">
    <defName>DC_Thought_InsectTrauma</defName>
    <label>insect horror</label>
    <durationDays>40</durationDays>
    <stages>
      <li>
        <label>swarm nightmares</label>
        <description>Dreams of chitin and endless skittering.</description>
        <baseMoodEffect>-12</baseMoodEffect>
      </li>
      <li>
        <label>insect dread</label>
        <description>Still jumps at sudden movement in the dark.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
      <li>
        <label>insect fear fading</label>
        <description>The swarm feels less immediate.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="DC_TraumaThoughtBase">
    <defName>DC_Thought_Betrayal</defName>
    <label>betrayal trauma</label>
    <durationDays>50</durationDays>
    <stages>
      <li>
        <label>raw betrayal</label>
        <description>Trusted someone who turned a blade on them.</description>
        <baseMoodEffect>-14</baseMoodEffect>
      </li>
      <li>
        <label>trust shattered</label>
        <description>Hard to believe anyone means well.</description>
        <baseMoodEffect>-9</baseMoodEffect>
      </li>
      <li>
        <label>learning to trust again</label>
        <description>The wound is closing, carefully.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- A08 scar / B06 seasoned / B05 flashback / B18 remembrance / B21 warden -->
  <ThoughtDef>
    <defName>DC_Thought_TraumaScar</defName>
    <label>old trauma scar</label>
    <durationDays>20</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>carries an old scar</label>
        <description>The trauma healed, but a quiet mark remains.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_Seasoned</defName>
    <label>seasoned survivor</label>
    <durationDays>15</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>seasoned by hardship</label>
        <description>Recovered from trauma and came out stronger.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_Flashback</defName>
    <label>flashback</label>
    <durationDays>0.15</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>flashback</label>
        <description>A sudden, vivid return to the moment of trauma.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_DayOfRemembrance</defName>
    <label>day of remembrance</label>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>day of remembrance</label>
        <description>The colony remembers those who fell on this day.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_PerkReflection</defName>
    <label>reflection</label>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>reflecting on a forgotten perk</label>
        <description>Letting go of hard-won expertise stings.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_Heirloom</defName>
    <label>heirloom</label>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>carrying an heirloom</label>
        <description>A piece of a fallen colonist's story rests in their hands.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_TraumaWarden</defName>
    <label>warden dread</label>
    <workerClass>DeepColony.ThoughtWorker_TraumaWarden</workerClass>
    <stages>
      <li>
        <label>dreads warden duty</label>
        <description>Captivity trauma makes guarding prisoners feel like being back in chains.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_GrewUpHere</defName>
    <label>grew up here</label>
    <durationDays>20</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>I grew up here</label>
        <description>This colony is home. The walls, the faces, the harvests — they remember being small here.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_ChildRaidWitness</defName>
    <label>saw the fighting</label>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>saw the fighting</label>
        <description>A child who watched violence they were too young to join.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_GrandChefHomestead</defName>
    <label>homestead cooking</label>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>homestead cooking</label>
        <description>A Grand Chef tasting pantry food the way it was meant to be eaten.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_FamilyMeal</defName>
    <label>family meal</label>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>ate with family</label>
        <description>A meal shared with kin under the same roof.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_ParentReunion</defName>
    <label>parent reunion</label>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>home with a parent</label>
        <description>Returned to a map where a parent still lives.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>DC_Thought_SpouseRemembrance</defName>
    <label>remembering a spouse</label>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>remembering a spouse</label>
        <description>The funeral or remembrance day hits harder for a lost love.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <label>colony sibling</label>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>DeepColony.ThoughtWorker_SiblingBond</workerClass>
    <stages>
      <li>
        <label>colony sibling</label>
        <description>Grew up together in this colony. The bond is quieter than rivalry.</description>
        <baseOpinionOffset>10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="DC_TraumaThoughtBase" MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>DC_Thought_Horror</defName>
    <label>horror trauma</label>
    <durationDays>40</durationDays>
    <stages>
      <li>
        <label>void-haunted (raw)</label>
        <description>Something inhuman brushed the mind and will not leave.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
      <li>
        <label>processing horror</label>
        <description>Counseling helps, but the entity's shape still returns at night.</description>
        <baseMoodEffect>-7</baseMoodEffect>
      </li>
      <li>
        <label>fading horror</label>
        <description>The worst of the void-memory is loosening.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="DC_TraumaThoughtBase" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>DC_Thought_Isolation</defName>
    <label>isolation trauma</label>
    <durationDays>35</durationDays>
    <stages>
      <li>
        <label>adrift (raw)</label>
        <description>Too long alone off-world, or the wreck of a gravship.</description>
        <baseMoodEffect>-9</baseMoodEffect>
      </li>
      <li>
        <label>processing isolation</label>
        <description>The silence of orbit still rings.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
      <li>
        <label>fading isolation</label>
        <description>Ground and company are slowly convincing them they made it back.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
