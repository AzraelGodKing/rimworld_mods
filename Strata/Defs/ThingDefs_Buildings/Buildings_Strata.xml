<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ DEPRECATED cargo lift (save-compat stub only) ============ -->
  <!-- Not buildable (no designationCategory). Exists so saves made while the
       cargo lift still existed load without errors; deconstruct any leftovers. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_CargoLift</defName>
    <label>cargo lift (deprecated)</label>
    <description>This building has been removed from Strata. Deconstruct it - haulers plus a stockpile by the stairs move goods between levels now.</description>
    <thingClass>Strata.Building_CargoLift</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/CargoLift</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0.4</Flammability>
    </statBases>
    <canOverlapZones>false</canOverlapZones>
  </ThingDef>

  <!-- ============ Excavated stairwell (down) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_StairsDown</defName>
    <label>excavated stairwell</label>
    <description>A broad staircase carved down into the rock beneath the colony. Completing it opens a new underground level: a solid stratum of stone the same size as this map, directly beneath it, that can be mined out into rooms, workshops, and vaults. The first basement from the surface requires digging down research; every level below that requires deep excavation research. Note: on large map sizes each opened level adds correspondingly more load.

Colonists will use the stairwell on their own to work, eat, and sleep across levels. The shaft also ties both floors' power grids together when each level is wired into the stairwell — keep a battery on each level for surplus to pool across. It cannot be deconstructed while anyone is still below.</description>
    <thingClass>Strata.Building_StairsDown</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/StairsDown</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <WoodLog>60</WoodLog>
      <Steel>30</Steel>
    </costList>
    <portal>
      <pocketMapGenerator>Strata_UndergroundLevel</pocketMapGenerator>
      <exitDef>Strata_StairsUp</exitDef>
      <pocketMapSize>200</pocketMapSize>
    </portal>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <placeWorkers>
      <li>Strata.PlaceWorker_LevelExcavation</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
        <basePowerConsumption>10</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="Strata.CompProperties_StairwellControl"/>
    </comps>
    <researchPrerequisites>
      <li>Strata_DiggingDown</li>
    </researchPrerequisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- Dig-down extension beside a landing — same portal as a stairwell but no
