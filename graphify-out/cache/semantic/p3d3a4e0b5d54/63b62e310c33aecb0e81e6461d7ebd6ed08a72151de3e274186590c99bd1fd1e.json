{"nodes": [{"id": "docs_ideas_homesteader_updates_homesteader", "label": "Homesteader update pool", "file_type": "document", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Make the yard, pantry and table feel lived-in (seasons, livestock personality, improving preserves, a farm others notice) without becoming a second cooking overhaul or a world-politics mod."}, {"id": "docs_ideas_homesteader_updates_lane_rule", "label": "Homesteader lane rule", "file_type": "rationale", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Player-colony agrarian fantasy only: off-map faction sims go to Living World, pantry-targeting hunters to Nemesis (defName list only), and colonist identity to Deep Colony."}, {"id": "docs_ideas_homesteader_updates_already_in", "label": "Already-shipped Homesteader systems", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maypole aura, coop, orchard, apiary, cellar/icehouse/springhouse, dairy pipeline, tastes/allergies, the Dubs Bad Hygiene water bridge and CN/RU packs are in, so the missing piece is an annual festival ritual rather than another pole."}, {"id": "docs_ideas_homesteader_updates_goatpen_removed", "label": "Homesteader_GoatPen removed (do not restore)", "file_type": "rationale", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The def was removed from the ship and must not come back; returning dairy livestock must use a new dairy shed id (HS-A07) so old saves are not re-bound to the dead def."}, {"id": "docs_ideas_homesteader_updates_hs_q01", "label": "HS-Q01 Homesteader architect tab", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shipped as the homestead tab: fixes Steam complaints about Furniture-tab bloat without requiring Adaptive Storage Framework."}, {"id": "docs_ideas_homesteader_updates_hs_q02", "label": "HS-Q02 ASF Storage tab patch (rejected)", "file_type": "rationale", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly 'do not': ASF is a framework with no architect tab and the old patch hid Homesteader storage; the homestead tab (HS-Q01) is the fix."}, {"id": "docs_ideas_homesteader_updates_hs_q03", "label": "HS-Q03 directional texture audit", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A missing _north must never pink-check; already shipped in repo, so the remaining check is that the Workshop zip is unpacked rather than shipping Texture.rar."}, {"id": "docs_ideas_homesteader_updates_hs_q04", "label": "HS-Q04 settings pack", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adopts Deep Colony's 'players can tone it down' habit; today's only setting is a DevMode allergy reveal."}, {"id": "docs_ideas_homesteader_updates_station_split", "label": "Keep station split, document instead of merging", "file_type": "rationale", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Despite 'too many similar stations' feedback, hearth/stove and drying/curing stay separate (hearth cooks, stove heats; dry versus salt are different jobs) and the split is documented in About/FAQ, revisited only if playtests agree."}, {"id": "docs_ideas_homesteader_updates_hs_a01", "label": "HS-A01 harvest festival", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_homesteader_updates_hs_a02", "label": "HS-A02 well-stocked larder thought", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts distinct kinds of preserved food (3/6/9 tiers), not stacks, so hoarding one product does not score."}, {"id": "docs_ideas_homesteader_updates_hs_a03", "label": "HS-A03 aging preserves", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs a ticker, so it must be capped to avoid a 24/7 map scan; the icehouse can slow aging as a counterweight."}, {"id": "docs_ideas_homesteader_updates_hs_a04", "label": "HS-A04 farmstand and colony brand", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brand is a Homesteader-local score in its own component and must never call AddFactionDrift, because Deep Colony owns faction goodwill."}, {"id": "docs_ideas_homesteader_updates_hs_a07", "label": "HS-A07 dairy shed", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_homesteader_updates_hs_a08", "label": "HS-A08 bees need bloom", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hive output scales down without flowers or crops in radius, which makes the orchard earn its keep instead of being decoration."}, {"id": "docs_ideas_homesteader_updates_hs_a11", "label": "HS-A11 waterwheel", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_homesteader_updates_hs_a13", "label": "HS-A13 rain-aware barrels", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Follows Stormproof storm/drought when loaded and falls back to vanilla rain when absent."}, {"id": "docs_ideas_homesteader_updates_hs_s01", "label": "HS-S01 Living World famine flavor", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyed letter lines only when Living World reports outlander famine or refugees; no farmstand logic moves into Living World."}, {"id": "docs_ideas_homesteader_updates_hs_s03", "label": "HS-S03 Deep Colony cooking perk pairing", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deep Colony owns the perk hook; Homesteader contributes only the food list and defNames, pairing with DC-C09."}, {"id": "docs_ideas_homesteader_updates_hs_s04", "label": "HS-S04 Nemesis pantry defName list", "file_type": "concept", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nemesis implements the sabotage hunt; Homesteader only keeps the smokehouse/cellar/farmstand defNames stable."}, {"id": "docs_ideas_homesteader_updates_depth_before_width", "label": "Depth before width", "file_type": "rationale", "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More orchard species wait until aging and the festival ship, and the gravship hydroponic homestead stays parked unless gravship players ask."}], "edges": [{"source": "docs_ideas_homesteader_updates_hs_a03", "target": "docs_homesteader_catalog_cheese_press", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_homesteader_updates_hs_a02", "target": "docs_homesteader_catalog_foods_pantry", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_homesteader_updates_station_split", "target": "docs_homesteader_catalog_drying_rack", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_homesteader_updates_hs_a13", "target": "docs_homesteader_catalog_water_craftables", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_homesteader_updates_hs_s04", "target": "docs_homesteader_catalog_smokehouse", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/ideas/homesteader-updates.md", "source_location": null, "weight": 1.0}, {