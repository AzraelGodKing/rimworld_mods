{"nodes": [{"id": "docs_ideas_deep_colony_touch_averse_touch_need_traits", "label": "Touch-need traits (F01 / F02)", "file_type": "document", "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comfort became a named ladder instead of one yes/no so a touch-averse pawn can be fine with a specific person without being fine with everyone; shipped as touch-need-v1."}, {"id": "docs_ideas_deep_colony_touch_averse_comfort_tiers", "label": "Comfort tiers (Distant to Intimate)", "file_type": "concept", "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bands scale from the settings 'fine with touch' threshold (default 0.65) so one slider moves the whole ladder."}, {"id": "docs_ideas_deep_colony_touch_averse_touchcomfortbypawn", "label": "touchComfortByPawn (per-pawn comfort store)", "file_type": "concept", "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stored per other pawn's thingIDNumber on Comp_DeepColony as 0-1; ex-lovers and partners seed at max and blood family seeds at intimate minimum so kin never read as 'too close'."}, {"id": "docs_ideas_deep_colony_touch_averse_dc_touchaverse", "label": "DC_TouchAverse trait", "file_type": "concept", "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three degrees (reserved, touch-averse, touch-intolerant) each requiring a higher tier for romance; existing saves stay at degree 0 and Nudist conflicts only with the averse degrees."}, {"id": "docs_ideas_deep_colony_touch_averse_dc_touchstarved", "label": "DC_TouchStarved trait", "file_type": "concept", "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The inverse of averse: still will not fall for a stranger but builds comfort faster and gets 1.6x romance selection weight once the gate passes."}, {"id": "docs_ideas_deep_colony_touch_averse_dc_tactile", "label": "DC_Tactile trait", "file_type": "concept", "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_deep_colony_touch_averse_dc_cuddly", "label": "DC_Cuddly trait", "file_type": "concept", "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shares the comfort meter for mood only and deliberately does not override vanilla's refusal to share a bed with a non-partner, which stays Homesteader polyarmory's lane."}, {"id": "docs_ideas_deep_colony_touch_averse_romance_gate", "label": "Touch-comfort romance gate", "file_type": "concept", "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hooks RandomSelectionWeight, SuccessChance, RomanceEligiblePair and AddDirectRelation; organic attempts also need touching distance, player-ordered romance still needs the tier, and float-menu fail text names current versus required tier so the gate is legible."}, {"id": "docs_ideas_deep_colony_touch_averse_non_goals", "label": "Touch-need non-goals", "file_type": "rationale", "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Date Night courtship-before-lovers stage and no new trauma def, keeping the feature inside the existing trait and comfort systems."}], "edges": [{"source": "docs_ideas_deep_colony_touch_averse_touch_need_traits", "target": "docs_ideas_deep_colony_updates_deep_colony", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_deep_colony_touch_averse_touch_need_traits", "target": "docs_ideas_deep_colony_touch_averse_comfort_tiers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_deep_colony_touch_averse_comfort_tiers", "target": "docs_ideas_deep_colony_touch_averse_touchcomfortbypawn", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_deep_colony_touch_averse_dc_touchaverse", "target": "docs_ideas_deep_colony_touch_averse_comfort_tiers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_deep_colony_touch_averse_dc_touchstarved", "target": "docs_ideas_deep_colony_touch_averse_dc_touchaverse", "relation": "semantically_similar_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_deep_colony_touch_averse_dc_tactile", "target": "docs_ideas_deep_colony_touch_averse_touchcomfortbypawn", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/deep-colony-touch-averse.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_deep_colony_touch_averse_dc_cuddly", "target": "docs_ideas_deep_colony_