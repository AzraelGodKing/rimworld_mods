<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Hand-dug well ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Wellspring_HandDugWell</defName>
    <label>hand-dug well</label>
    <description>A stone-lined well with a wooden windlass and bucket. On-demand water: colonists spend labor and get five jugs, rain or drought. Slow honest work — replace it with a deep well when the homestead's thirst outruns the bucket.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Wellspring/Buildings/HandDugWell</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.4,1.8)</drawSize>
      <drawOffset>(0,0,0.3)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.45</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>0.3</Flammability>
    </statBases>
    <costList>
      <WoodLog>40</WoodLog>
      <Steel>10</Steel>
    </costList>
    <comps>
      <li Class="Homesteader.CompProperties_WaterSense"/>
    </comps>
    <recipes>
      <li>Wellspring_DrawWater</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Wellspring_Wellcraft</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Rain barrel ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Wellspring_RainBarrel</defName>
    <label>rain barrel</label>
    <description>A lidded wooden barrel that slowly collects rainwater and morning dew. Cheap starter catch — a trickle of three jugs every day or two, dumped beside the barrel where they can weather. Upgrade to a cistern when you need a real reserve.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Wellspring/Buildings/RainBarrel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>0.8</Flammability>
    </statBases>
    <costList>
      <WoodLog>30</WoodLog>
    </costList>
    <comps>
      <li Class="CompProperties_Spawner">
        <thingToSpawn>Wellspring_Water</thingToSpawn>
        <spawnCount>3</spawnCount>
        <spawnIntervalRange>70000~110000</spawnIntervalRange>
        <spawnMaxAdjacent>12</spawnMaxAdjacent>
        <spawnForbidden>false</spawnForbidden>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
        <showMessageIfOwned>false</showMessageIfOwned>
        <saveKeysPrefix>rainwater</saveKeysPrefix>
      </li>
      <li Class="Homesteader.CompProperties_WaterSense"/>
    </comps>
    <designationCategory>Production</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Wellspring_Wellcraft</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Cistern ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Wellspring_Cistern</defName>
    <label>cistern</label>
    <description>A wide, covered stone tank that catches runoff and dew, then keeps the jugs where they will not weather. Holds eight stacks and slowly fills itself — a rain barrel that actually stores what it catches. Replace barrels with this once the homestead drinks faster than a trickle.</description>
    <thingClass>Building_Storage</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Wellspring/Buildings/Cistern</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.6</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,1)</size>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>1400</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0.1</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <WoodLog>25</WoodLog>
      <Steel>25</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Spawner">
        <thingToSpawn>Wellspring_Water</thingToSpawn>
        <spawnCount>8</spawnCount>
        <spawnIntervalRange>50000~80000</spawnIntervalRange>
        <spawnMaxAdjacent>40</spawnMaxAdjacent>
        <spawnForbidden>false</spawnForbidden>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
        <showMessageIfOwned>false</showMessageIfOwned>
        <saveKeysPrefix>cistern</saveKeysPrefix>
      </li>
      <li Class="Homesteader.CompProperties_WaterSense"/>
    </comps>
    <building>
      <storageGroupTag>HomesteaderStorage</storageGroupTag>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <maxItemsInCell>4</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <thingDefs>
            <li>Wellspring_Water</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>Wellspring_Water</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Homesteader_Storage</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Wellspring_Wellcraft</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Deep well ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Wellspring_DeepWell</defName>
    <label>deep well</label>
    <description>A reinforced shaft sunk far past the shallow groundwater, with a heavy steel windlass and a wide bucket. Each haul brings up twenty jugs — four times a hand-dug well — for only a little more work. Build this when colonists spend their days on the windlass instead of the fields.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Wellspring/Buildings/DeepWell</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.9)</drawSize>
      <drawOffset>(0,0,0.35)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>3500</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <costList>
      <WoodLog>30</WoodLog>
      <Steel>60</Steel>
    </costList>
    <comps>
      <li Class="Homesteader.CompProperties_WaterSense"/>
    </comps>
    <recipes>
      <li>Wellspring_DrawWaterDeep</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Wellspring_Waterworks</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Solar still ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Wellspring_SolarStill</defName>
    <label>solar still</label>
    <description>A shallow pit lined with hide and glass that sweats moisture out of the ground and air. Slow, and it yields boiled water already — the arid-biome sidegrade, not a faster rain barrel. Use it where rain never comes, or when you want clean jugs without a stove.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Wellspring/Buildings/SolarStill</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.25</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>700</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <WoodLog>15</WoodLog>
      <Steel>15</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Spawner">
        <thingToSpawn>Wellspring_BoiledWater</thingToSpawn>
        <spawnCount>1</spawnCount>
        <spawnIntervalRange>40000~70000</spawnIntervalRange>
        <spawnMaxAdjacent>15</spawnMaxAdjacent>
        <spawnForbidden>false</spawnForbidden>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
        <showMessageIfOwned>false</showMessageIfOwned>
        <saveKeysPrefix>solarstill</saveKeysPrefix>
      </li>
    </comps>
    <designationCategory>Production</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Wellspring_Wellcraft</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Water tower ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Wellspring_WaterTower</defName>
    <label>water tower</label>
    <description>A tall timber-framed tank on stout legs: gravity catchment plus a serious reserve out of the sun and the mud. Holds twenty-four stacks (six per cell), fills faster than a cistern, and haulers treat it as critical. Replace cisterns when irrigation and the kitchen start emptying the tank overnight.</description>
    <thingClass>Building_Storage</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Wellspring/Buildings/WaterTower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2.7)</drawSize>
      <drawOffset>(0,0,0.35)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <fillPercent>0.8</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>2800</WorkToBuild>
      <Mass>70</Mass>
      <Flammability>0.6</Flammability>
      <Beauty>8</Beauty>
    </statBases>
    <costList>
      <WoodLog>50</WoodLog>
      <Steel>50</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Spawner">
        <thingToSpawn>Wellspring_Water</thingToSpawn>
        <spawnCount>12</spawnCount>
        <spawnIntervalRange>40000~60000</spawnIntervalRange>
        <spawnMaxAdjacent>75</spawnMaxAdjacent>
        <spawnForbidden>false</spawnForbidden>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
        <showMessageIfOwned>false</showMessageIfOwned>
        <saveKeysPrefix>watertower</saveKeysPrefix>
      </li>
      <li Class="Homesteader.CompProperties_WaterSense"/>
    </comps>
    <building>
      <storageGroupTag>HomesteaderStorage</storageGroupTag>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <maxItemsInCell>6</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <thingDefs>
            <li>Wellspring_Water</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Critical</priority>
        <filter>
          <thingDefs>
            <li>Wellspring_Water</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Homesteader_Storage</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Wellspring_Waterworks</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Stone fountain ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Wellspring_StoneFountain</defName>
    <label>stone fountain</label>
    <description>A carved stone basin with a plume at its center — the waterworks courtyard flex. Haul water jugs into it; it drinks about two a day. Beauty only while the water is flowing. Empty, it is just a dry bowl.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Wellspring/Buildings/StoneFountain</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>120</costStuffCount>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>45</Mass>
      <Flammability>0</Flammability>
      <Beauty>8</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>2.0</fuelConsumptionRate>
        <fuelCapacity>50.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>Wellspring_Water</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>0</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <consumeFuelOnlyWhenUsed>false</consumeFuelOnlyWhenUsed>
      </li>
      <li Class="Homesteader.CompProperties_BeautyWhenFueled">
        <fueledBeauty>32</fueledBeauty>
        <dryBeauty>0</dryBeauty>
      </li>
    </comps>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Wellspring_Waterworks</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Irrigated planter ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Wellspring_IrrigatedPlanter</defName>
    <label>irrigated planter</label>
    <description>A deep wooden planter box with a water reservoir worked into its base. Grows a single crop in rich, constantly-moist soil - a little irrigated field you can put anywhere, even indoors.</description>
    <thingClass>Building_PlantGrower</thingClass>
    <graphicData>
      <texPath>Wellspring/Buildings/IrrigatedPlanter</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.3</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <fertility>1.30</fertility>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>0.6</Flammability>
    </statBases>
    <costList>
      <WoodLog>25</WoodLog>
      <Wellspring_Water>2</Wellspring_Water>
    </costList>
    <building>
      <defaultPlantToGrow>Plant_Potato</defaultPlantToGrow>
      <sowTag>Ground</sowTag>
    </building>
    <designationCategory>Production</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Wellspring_Irrigation</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
