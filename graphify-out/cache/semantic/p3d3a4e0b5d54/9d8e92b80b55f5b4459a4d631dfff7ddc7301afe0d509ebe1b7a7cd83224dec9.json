{"nodes": [{"id": "docs_ideas_deep_colony_batch_c_batch_c", "label": "Deep Colony Batch C (post-2.0)", "file_type": "document", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new batch was opened because 2.0 filled perk/trauma/mentor/generation/reputation depth but had zero Royalty/Ideology/Biotech/Anomaly/Odyssey hooks, little sibling flavor, and thin QoL around the three new tabs; Workshop feedback only raised mid-save performance, which was answered."}, {"id": "docs_ideas_deep_colony_batch_c_lane_rule", "label": "Deep Colony lane rule", "file_type": "rationale", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Colonist/colony-facing only: no furniture packs, raid timers, off-map politics, farm brand, or a second goodwill buffer, so each sibling mod keeps one clear ownership lane."}, {"id": "docs_ideas_deep_colony_batch_c_prefer_small_medium", "label": "Prefer S/M over another Hard-gated power layer", "file_type": "rationale", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Players feel small and medium polish immediately, whereas another gated power tier mostly adds settings surface."}, {"id": "docs_ideas_deep_colony_batch_c_dc_c01", "label": "DC-C01 untreated-trauma alert", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses the unspent-perk-point pattern with a 1-day grace; chosen as opt-in UI rather than a tick tax because the Workshop asked about FPS."}, {"id": "docs_ideas_deep_colony_batch_c_dc_c03", "label": "DC-C03 Ideology precepts for counseling", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fail-open with no hard Ideology dependency: 'Counseling is sacred' versus 'Stoic: skip therapy, slower natural fade'."}, {"id": "docs_ideas_deep_colony_batch_c_dc_c04", "label": "DC-C04 Royalty titles as envoy bias", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fail-open if Royalty is absent; titled pawns are only suggested first, with at most a tiny goodwill nudge, so it stays flavor rather than a power spike."}, {"id": "docs_ideas_deep_colony_batch_c_dc_c08", "label": "DC-C08 Date Night confidants", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lovers reach confidant in 2 counsel sessions instead of 3; Date Night stays optional and the hook fails open."}, {"id": "docs_ideas_deep_colony_batch_c_dc_c09", "label": "DC-C09 Homesteader meals + cooking perk", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grand Chef's extra mood applies only to Homesteader pantry foods; fail-open, and the farm brand stays Homesteader's."}, {"id": "docs_ideas_deep_colony_batch_c_dc_c10", "label": "DC-C10 sibling disaster flavor", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strata cave-ins and Stormproof ion-storm downs reuse existing combat/fire/toxic trauma with a keyed reason, so no new TraumaDefs are required."}, {"id": "docs_ideas_deep_colony_batch_c_dc_c12", "label": "DC-C12 deathbed lesson", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_deep_colony_batch_c_dc_c15", "label": "DC-C15 apology / tribute", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spending silver or a gift writes a ledger row through AddFactionDrift so no parallel goodwill buffer is introduced."}, {"id": "docs_ideas_deep_colony_batch_c_dc_c18", "label": "DC-C18 funerals ease violent loss", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A vanilla grave is enough without Ideology; an Ideology funeral ritual is used when present, so the feature degrades gracefully."}, {"id": "docs_ideas_deep_colony_batch_c_dc_c23", "label": "DC-C23 envoy visit caravan", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settings-gated and scheduled last, to be skipped entirely if caravan handling proves messy."}, {"id": "docs_ideas_deep_colony_batch_c_dropped_ideas", "label": "Batch C deliberate drops", "file_type": "rationale", "source_file": "docs/ideas/deep-colony-batch-c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extra perk tiers, respec variants, chronic-trauma 2, farmstand, named hunters, world chronicle UI, guest teachers, school furniture and a remembrance-calendar UI were dropped on purpose (B18 already covers remembrance)."}], "edges": [{"source": "docs_ideas_deep_col