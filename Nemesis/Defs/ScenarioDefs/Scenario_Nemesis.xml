<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Flavor scenario: classic crashlanded start with storyteller-facing hints about personal antagonists. -->
  <ScenarioDef>
    <defName>Nemesis_Marked</defName>
    <label>Marked</label>
    <description>Three crashlanders claw out a foothold on a hostile rimworld. Somewhere out there, someone is already learning your names.\n\n(Requires the Nemesis mod. Hunts still roll from normal triggers — this scenario is a thematic start with tips, not a scripted vendetta.)</description>
    <scenario>
      <summary>Crashlanded start. Expect personal attention sooner or later.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>3</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
        </li>
        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <count>1</count>
          <bondToRandomPlayerPawnChance>1</bondToRandomPlayerPawnChance>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>18</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>8</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>10</count>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>You are not alone on this rim. Hostile factions keep ledgers — and sometimes one name rises to the top.\n\nIf Nemesis is active, watch for personal taunts, false leads, and a hunter who flees when losing. Capture them, kill them, or outlast them. If they fixate on someone, that person's death can end the hunt on their terms.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
