<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>DC_Archive</defName>
    <label>colony archive</label>
    <description>Wooden shelves for the colony's notes. With Codex on, if a researcher dies and these still stand, the current project does not slip. Burn the archive and the next death can cost you the work.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Furniture/Dresser</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <WoodLog>50</WoodLog>
    </costList>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>
</Defs>
