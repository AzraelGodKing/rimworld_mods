      <li>
        <label>active</label>
        <statOffsets>
          <MedicalTendQuality>0.12</MedicalTendQuality>
          <MedicalSurgerySuccessChance>0.10</MedicalSurgerySuccessChance>
        </statOffsets>
        <statFactors>
          <MedicalOperationSpeed>1.20</MedicalOperationSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

