<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <WorldObjectDef>
    <defName>LivingWorld_WarSite</defName>
    <label>war scar</label>
    <description>A short-lived scar from an off-map battle — debris, camps, or contested ground. Not a personal nemesis site.</description>
    <worldObjectClass>LivingWorld.WorldObject_LivingWorldWarSite</worldObjectClass>
    <texture>LivingWorld/World/WarScar</texture>
    <expandingIconTexture>LivingWorld/World/WarScar</expandingIconTexture>
    <expandingIcon>true</expandingIcon>
    <expandingIconPriority>30</expandingIconPriority>
    <expandingIconColor>(0.75, 0.45, 0.25)</expandingIconColor>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>LivingWorld_WayCamp</defName>
    <label>way-camp</label>
    <description>A camp your caravans founded on a stretch of road they already walked. Overnight rest here is a little easier — not a settlement, not a war scar.</description>
    <worldObjectClass>LivingWorld.WorldObject_LivingWorldWayCamp</worldObjectClass>
    <texture>LivingWorld/World/WayCamp</texture>
    <expandingIconTexture>LivingWorld/World/WayCamp</expandingIconTexture>
    <expandingIcon>true</expandingIcon>
    <expandingIconPriority>28</expandingIconPriority>
    <expandingIconColor>(0.45, 0.62, 0.38)</expandingIconColor>
  </WorldObjectDef>

  <WorldObjectDef>
    <defName>LivingWorld_TrafficCaravan</defName>
    <label>traveling caravan</label>
    <description>An NPC caravan on its way from one settlement to another. It is not headed for you, usually.</description>
    <worldObjectClass>LivingWorld.WorldObject_LivingWorldTraffic</worldObjectClass>
    <texture>World/WorldObjects/Caravan</texture>
    <useDynamicDrawer>true</useDynamicDrawer>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/Caravan</expandingIconTexture>
    <expandingIconPriority>60</expandingIconPriority>
  </WorldObjectDef>

</Defs>
