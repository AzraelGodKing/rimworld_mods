    </statBases>
    <graphicData>
      <texPath>Homesteader/Plants/PumpkinPlant</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>16</pathCost>
    <ingestible>
      <foodType>Plant</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <fertilityMin>0.6</fertilityMin>
      <fertilitySensitivity>0.8</fertilitySensitivity>
      <growDays>10</growDays>
      <sowMinSkill>4</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <visualSizeRange>0.4~1.1</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>Homesteader_RawPumpkin</harvestedThingDef>
      <harvestYield>16</harvestYield>
      <dieIfLeafless>true</dieIfLeafless>
      <maxMeshCount>1</maxMeshCount>
      <blockAdjacentSow>false</blockAdjacentSow>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>
    </plant>
  </ThingDef>

