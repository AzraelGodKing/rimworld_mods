<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Render lard ============ -->
  <RecipeDef>
    <defName>Homesteader_RenderLard</defName>
    <label>render lard</label>
    <description>Render soft fat from raw meat into cooking lard.</description>
    <jobString>Rendering lard.</jobString>
    <workAmount>700</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
          <disallowedThingDefs>
            <li>Homesteader_SmokedMeat</li>
            <li>Homesteader_SaltedMeat</li>
            <li>Homesteader_SmokedFish</li>
            <li>Homesteader_SaltedFish</li>
          </disallowedThingDefs>
        </filter>
        <count>15</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
      <disallowedThingDefs>
        <li>Homesteader_SmokedMeat</li>
        <li>Homesteader_SaltedMeat</li>
        <li>Homesteader_SmokedFish</li>
        <li>Homesteader_SaltedFish</li>
      </disallowedThingDefs>
    </fixedIngredientFilter>
    <products>
      <Homesteader_Lard>8</Homesteader_Lard>
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

