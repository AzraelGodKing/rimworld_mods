<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Azrael.ModChecks</RootNamespace>
    <AssemblyName>Azrael.ModChecks</AssemblyName>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" GeneratePathProperty="true">
      <ExcludeAssets>compile;runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="CopyKrafsRef" AfterTargets="Build">
    <ItemGroup>
      <KrafsDll Include="$(PkgKrafs_Rimworld_Ref)\ref\net472\*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)krafs-ref" />
    <Copy SourceFiles="@(KrafsDll)" DestinationFolder="$(OutputPath)krafs-ref" SkipUnchangedFiles="true" Condition="'@(KrafsDll)' != ''" />
  </Target>
</Project>
