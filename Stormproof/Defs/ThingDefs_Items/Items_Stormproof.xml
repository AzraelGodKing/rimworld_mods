      <texPath>Stormproof/Items/Fulgurite</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>25</stackLimit>
    <tradeability>All</tradeability>
    <stuffProps>
      <categories>
        <li>Stony</li>
      </categories>
      <color>(0.72, 0.82, 0.70)</color>
      <commonality>0.02</commonality>
      <statOffsets>
        <Beauty>4</Beauty>
      </statOffsets>
    </stuffProps>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>0</Flammability>
      <DeteriorationRate>0.2</DeteriorationRate>
      <Mass>0.4</Mass>
      <MarketValue>95</MarketValue>
      <StuffPower_Armor_Sharp>0.6</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.4</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.8</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>4</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>6</StuffPower_Insulation_Heat>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
  </ThingDef>

</Defs>
