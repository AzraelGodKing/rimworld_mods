<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Chicken coop ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_ChickenCoop</defName>
    <label>chicken coop</label>
    <description>A straw-lined coop that keeps a small flock laying. Eggs appear beside the coop on their own schedule - keep feed mash nearby and nesting boxes for happier hens.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/ChickenCoop</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.45</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0.9</Flammability>
      <Beauty>3</Beauty>
    </statBases>
    <costList>
      <WoodLog>50</WoodLog>
      <Hay>20</Hay>
    </costList>
    <comps>
      <li Class="CompProperties_Spawner">
        <thingToSpawn>EggChickenUnfertilized</thingToSpawn>
        <spawnCount>6</spawnCount>
        <spawnIntervalRange>90000~150000</spawnIntervalRange>
        <spawnMaxAdjacent>36</spawnMaxAdjacent>
        <spawnForbidden>false</spawnForbidden>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
        <showMessageIfOwned>true</showMessageIfOwned>
        <saveKeysPrefix>eggs</saveKeysPrefix>
      </li>
      <li Class="Homesteader.CompProperties_PrizeFlock"/>
    </comps>
    <designationCategory>Production</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_Livestock</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
