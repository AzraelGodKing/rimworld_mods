<Defs>

  <!-- ============ Jerky ============ -->
  <ThingDef ParentName="ResourceBase">
    <defName>Homesteader_Jerky</defName>
    <label>jerky</label>
    <description>Strips of meat dried until tough and chewy. Keeps for two months and weighs almost nothing, making it ideal travel food and emergency rations.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Homesteader/Items/Jerky</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Rare</tickerType>
    <stackLimit>75</stackLimit>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>0.018</Mass>
      <MarketValue>1.8</MarketValue>
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Meal</foodType>
      <preferability>RawTasty</preferability>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>60</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>FoodMeals</li>
    </thingCategories>
  </ThingDef>

