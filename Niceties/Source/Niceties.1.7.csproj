<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Common\Azrael.Common.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Niceties</RootNamespace>
    <AssemblyName>Niceties</AssemblyName>
    <!-- RimWorld 1.7. Building Niceties.csproj does not overwrite this DLL. -->
    <OutputPath>../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Niceties files opt in with #nullable enable; shared Common files stay as they are. -->
    <Nullable>disable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4998-unstable" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.4" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
