<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ScenarioDef>
    <defName>Azrael_DeepHomestead</defName>
    <label>The Deep Homestead</label>
    <description>Three settlers dig in at the mountain foothills — wells and grain above, shafts below, storms on the horizon, and wars you only hear about until they wash refugees to your gate.\n\nRecommended: pick a mountainous or cave-friendly tile. Enable Homesteader, Strata, Stormproof, Living World, and Nemesis for the full series feel. Soft start parts apply when those mods are present.</description>
    <scenario>
      <summary>Three homesteaders under Azrael. Mountain foothills recommended. Series mods soft-optional.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <surfaceLayer>
        <def>SurfaceLayerFixed</def>
        <tag>Surface</tag>
        <layer>Surface</layer>
        <settingsDef>Surface</settingsDef>
        <hide>true</hide>
        <connections>
          <Orbit MayRequire="Ludeon.RimWorld.Odyssey">
            <zoomMode>ZoomOut</zoomMode>
          </Orbit>
        </connections>
      </surfaceLayer>
      <parts>

        <li MayRequire="Ludeon.RimWorld.Odyssey" Class="ScenPart_PlanetLayer">
          <def>PlanetLayer</def>
          <tag>Orbit</tag>
          <layer>Orbit</layer>
          <settingsDef>Orbit</settingsDef>
          <hide>true</hide>
          <connections>
            <Surface>
              <zoomMode>ZoomIn</zoomMode>
            </Surface>
          </connections>
        </li>

        <li Class="Azrael.ScenPart_ForcedStoryteller">
          <def>Azrael_ForcedStoryteller</def>
          <storyteller>Azrael</storyteller>
        </li>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>3</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>The foothills rise behind you. Wagon unloaded. Soil ready for seed — stone ready for shafts.

Distant wars rumble on the radio. Weather will try to break you. Dig deep if you must; farm hard if you can.

Azrael is watching. Build a homestead that outlasts the mountain.</text>
          <closeSound>GameStartSting</closeSound>
        </li>

        <li MayRequire="AzraelGodKing.Homesteader" Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>Homesteader_PrimitiveHomestead</project>
        </li>

        <li MayRequire="AzraelGodKing.Strata" Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>Strata_DiggingDown</project>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Silver</thingDef>
          <count>300</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>WoodLog</thingDef>
          <count>350</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Pemmican</thingDef>
          <count>120</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>16</count>
        </li>

        <li MayRequire="AzraelGodKing.Homesteader" Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Homesteader_RockSalt</thingDef>
          <count>30</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Bow_Short</thingDef>
          <count>2</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Knife</thingDef>
          <stuff>Steel</stuff>
          <count>1</count>
        </li>

        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <animalKind>Cow</animalKind>
          <count>1</count>
        </li>

        <li Class="ScenPart_StartingAnimal">
          <def>StartingAnimal</def>
          <animalKind>Chicken</animalKind>
          <count>3</count>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
