    <renderPrecedence>230</renderPrecedence>
    <pathCost>0</pathCost>
    <statBases>
      <WorkToBuild>320</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <costList>
      <Cloth>1</Cloth>
      <WoodLog>1</WoodLog>
    </costList>
    <researchPrerequisites>
      <li>Strata_DeepInfrastructure</li>
    </researchPrerequisites>
  </TerrainDef>
</Defs>
