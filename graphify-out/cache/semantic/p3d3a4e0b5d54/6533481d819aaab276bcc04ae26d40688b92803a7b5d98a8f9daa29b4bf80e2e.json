{"nodes": [{"id": "wavesurvivalreforged_readme_wave_survival_reforged", "label": "Wave Survival Reforged", "file_type": "document", "source_file": "WaveSurvivalReforged/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A from-scratch rewrite rather than a port because the Alpha 14 original shipped only a compiled DLL; storyteller art by Philbro is reused with credit."}, {"id": "wavesurvivalreforged_readme_original_wave_survival", "label": "Wave Survival [Game Mode] by Justin C (original)", "file_type": "document", "source_file": "WaveSurvivalReforged/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "wavesurvivalreforged_readme_one_source_two_versions", "label": "One source for 1.6 and 1.7 (AZR-592)", "file_type": "rationale", "source_file": "WaveSurvivalReforged/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decided 2026-11-07 (AZR-592): there is no frozen 1.6 build, both folders get every update, so 1.6 players are not stranded on an old branch."}, {"id": "wavesurvivalreforged_readme_wave_survival_storyteller", "label": "Wave Survival storyteller", "file_type": "concept", "source_file": "WaveSurvivalReforged/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything only runs while this storyteller is selected, so switching storyteller mid-game pauses the waves and no Harmony patching is needed."}, {"id": "wavesurvivalreforged_readme_pointsbywave", "label": "pointsByWave threat curve", "file_type": "concept", "source_file": "WaveSurvivalReforged/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "wavesurvivalreforged_readme_wsr_config", "label": "WSR_Config (WaveSurvivalConfig.xml)", 