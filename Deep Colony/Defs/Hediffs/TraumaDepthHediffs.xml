<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>DC_Hediff_Flashback</defName>
    <label>flashback</label>
    <description>A sudden traumatic flashback. Consciousness dips briefly.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500~4000</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>flashback</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DC_Hediff_CombatHabit</defName>
    <label>combat habits</label>
    <description>Trauma has changed how this person fights — slower to close, more deliberate aiming.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>active</label>
        <statFactors>
          <MeleeHitChance>0.88</MeleeHitChance>
          <AimingDelayFactor>1.12</AimingDelayFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DC_Hediff_TraumaDraftPenalty</defName>
    <label>trauma under fire</label>
    <description>Drafted while carrying combat trauma — accuracy and focus suffer. (Settings: trauma draft penalties.)</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>active</label>
        <statOffsets>
          <ShootingAccuracyPawn>-3</ShootingAccuracyPawn>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.04</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
