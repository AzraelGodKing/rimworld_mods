      <li>
        <label>active</label>
        <statOffsets>
          <MedicalTendQuality>0.08</MedicalTendQuality>
        </statOffsets>
        <statFactors>
          <MedicalTendSpeed>1.15</MedicalTendSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="DC_PerkHediffBase">
    <defName>DC_PerkHediff_SurgeonsTouch</defName>
    <label>surgeon's touch</label>
