<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Lard ============ -->
  <ThingDef ParentName="ResourceBase">
    <defName>Homesteader_Lard</defName>
    <label>lard</label>
    <description>Soft rendered fat from meat. Used for sausage, soap, and rich cooking.</description>
    <graphicData>
      <texPath>Homesteader/Items/Lard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>1.2</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>0.03</Mass>
      <MarketValue>1.5</MarketValue>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <!-- ============ Tallow ============ -->
  <ThingDef ParentName="ResourceBase">
    <defName>Homesteader_Tallow</defName>
    <label>tallow</label>
    <description>Hard rendered fat. Excellent for soap and long-keeping pantry craft.</description>
    <graphicData>
      <texPath>Homesteader/Items/Tallow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MaxHitPoints>55</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <Mass>0.03</Mass>
      <MarketValue>1.6</MarketValue>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <!-- ============ Sausage ============ -->
  <ThingDef ParentName="ResourceBase">
    <defName>Homesteader_Sausage</defName>
    <label>homestead sausage</label>
    <description>Salted or smoked meat stuffed with fat and dried herbs. Keeps well and eats like a trail meal.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Homesteader/Items/Sausage</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Rare</tickerType>
    <stackLimit>75</stackLimit>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.8</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>0.025</Mass>
      <MarketValue>2.4</MarketValue>
      <Nutrition>0.07</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Meal</foodType>
      <preferability>MealSimple</preferability>
      <tasteThought>Homesteader_AteHomesteadTreat</tasteThought>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>45</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>FoodMeals</li>
    </thingCategories>
  </ThingDef>

  <!-- ============ Animal mash ============ -->
  <ThingDef ParentName="ResourceBase">
    <defName>Homesteader_AnimalMash</defName>
    <label>animal mash</label>
    <description>Crushed barley and pumpkin cooked into a soft mash. Keeps livestock productive when left near coops and pens.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Homesteader/Items/AnimalMash</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Rare</tickerType>
    <stackLimit>150</stackLimit>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>0.8</Flammability>
      <DeteriorationRate>4</DeteriorationRate>
      <Mass>0.04</Mass>
      <MarketValue>0.8</MarketValue>
      <Nutrition>0.12</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Processed</foodType>
      <preferability>NeverForNutrition</preferability>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>20</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
  </ThingDef>

