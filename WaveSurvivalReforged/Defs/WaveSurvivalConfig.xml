<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <WaveSurvivalReforged.WaveSurvivalConfigDef>
    <defName>WSR_Config</defName>
    <label>wave survival settings</label>

    <daysBeforeFirstWave>5</daysBeforeFirstWave>
    <daysBetweenWaves>2</daysBetweenWaves>
    <!-- Hours after landing that waves land. Landing at 6 AM with 6 here means noon raids. -->
    <raidHourOffset>6</raidHourOffset>

    <!-- Extra days before the next wave after a special or boss wave. -->
    <breatherDays>0.5</breatherDays>
    <!-- A wave that cannot start (no home map, nobody able to attack) tries again this many hours later. -->
    <postponeHours>3</postponeHours>

    <!-- Every 4th wave comes from the Special pool and every 10th from the Boss pool
         (Boss wins). The wave types themselves are in WaveTypes.xml. bossWaveInterval 0 turns bosses off. -->
    <specialWaveInterval>4</specialWaveInterval>
    <specialWaveMinWave>1</specialWaveMinWave>
    <bossWaveInterval>10</bossWaveInterval>

    <!-- Threat points by wave number, before the difficulty's threat scale.
         Linear early (+50 a wave like 1.0), steeper later. -->
    <pointsByWave>
      <points>
        <li>(1, 50)</li>
        <li>(10, 500)</li>
        <li>(20, 1100)</li>
        <li>(30, 1800)</li>
        <li>(50, 3500)</li>
        <li>(100, 8000)</li>
      </points>
    </pointsByWave>
    <!-- 0 = waves follow the curve only. 1 = waves follow colony wealth like a vanilla storyteller. -->
    <wealthBlend>0</wealthBlend>
    <!-- Chance that a wave type with canSplit comes as two half-size raids. -->
    <doubleRaidChance>0.25</doubleRaidChance>

    <!-- Daily chances (0 to 1). -->
    <traderChance>0.2</traderChance>
    <weaponDropChance>0.2</weaponDropChance>
    <weaponBudget>200~400</weaponBudget>
    <weaponBudgetPerWave>25</weaponBudgetPerWave>

    <!-- Days in a row without a trade beacon before a half-size drop (no weapon) lands near
         the colony instead. 0 turns this off. -->
    <noBeaconFallbackDays>3</noBeaconFallbackDays>

    <!-- Rolled once a day and dropped at the orbital trade beacon. Nothing drops while the
         colony already holds maxStockpile of that item, counting loose items near the beacon. Survival meals drop whenever food
         runs low; that is not tunable here. -->
    <supplyDrops>
      <li>
        <thing>MedicineIndustrial</thing>
        <chance>0.15</chance>
        <count>2~6</count>
        <maxStockpile>15</maxStockpile>
      </li>
      <li>
        <thing>WoodLog</thing>
        <chance>0.33</chance>
        <count>25~200</count>
        <maxStockpile>500</maxStockpile>
      </li>
      <li>
        <thing>Steel</thing>
        <chance>0.33</chance>
        <count>50~250</count>
        <maxStockpile>1000</maxStockpile>
      </li>
      <li>
        <thing>BlocksGranite</thing>
        <chance>0.15</chance>
        <count>25~100</count>
        <maxStockpile>500</maxStockpile>
      </li>
      <li>
        <thing>BlocksLimestone</thing>
        <chance>0.10</chance>
        <count>25~100</count>
        <maxStockpile>500</maxStockpile>
      </li>
      <li>
        <thing>Silver</thing>
        <chance>0.10</chance>
        <count>25~100</count>
        <maxStockpile>5000</maxStockpile>
      </li>
      <li>
        <thing>ComponentIndustrial</thing>
        <chance>0.20</chance>
        <count>1~10</count>
        <maxStockpile>300</maxStockpile>
      </li>
    </supplyDrops>
  </WaveSurvivalReforged.WaveSurvivalConfigDef>

</Defs>
