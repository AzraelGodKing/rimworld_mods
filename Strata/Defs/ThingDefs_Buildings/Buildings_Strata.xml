<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ DEPRECATED cargo lift (save-compat stub only) ============ -->
  <!-- Not buildable (no designationCategory). Exists so saves made while the
       cargo lift still existed load without errors; deconstruct any leftovers. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_CargoLift</defName>
    <label>cargo lift (deprecated)</label>
    <description>This building has been removed from Strata. Deconstruct it - haulers plus a stockpile by the stairs move goods between levels now.</description>
    <thingClass>Strata.Building_CargoLift</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/CargoLift</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0.4</Flammability>
    </statBases>
    <canOverlapZones>false</canOverlapZones>
  </ThingDef>

  <!-- ============ Excavated stairwell (down) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_StairsDown</defName>
    <label>excavated stairwell</label>
    <description>A broad staircase carved down into the rock beneath the colony. Completing it opens a new underground level: a solid stratum of stone that can be mined out into rooms, workshops, and vaults.

Colonists will use the stairwell on their own to work, eat, and sleep across levels. The shaft also ties both floors' power grids together when each level is wired into the stairwell — keep a battery on each level for surplus to pool across. It cannot be deconstructed while anyone is still below.</description>
    <thingClass>Strata.Building_StairsDown</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/StairsDown</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <WoodLog>60</WoodLog>
      <Steel>30</Steel>
    </costList>
    <portal>
      <pocketMapGenerator>Strata_UndergroundLevel</pocketMapGenerator>
      <exitDef>Strata_StairsUp</exitDef>
      <pocketMapSize>200</pocketMapSize>
    </portal>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
        <basePowerConsumption>10</basePowerConsumption>
      </li>
      <li Class="Strata.CompProperties_StairwellControl"/>
    </comps>
    <researchPrerequisites>
      <li>Strata_Excavation</li>
    </researchPrerequisites>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- ============ Stairwell up (spawned at the bottom of the stairs) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_StairsUp</defName>
    <label>stairwell up</label>
    <description>The bottom landing of an excavated stairwell — a broad staircase leading back up to the level above. Wire your local grid into the stairwell on this floor so power can pool with the level above. It cannot be deconstructed; it is the way home.</description>
    <thingClass>Strata.Building_StairsUp</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/StairsUp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
        <basePowerConsumption>0</basePowerConsumption>
      </li>
    </comps>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- ============ Elevator (powered, compact) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_ElevatorDown</defName>
    <label>elevator</label>
    <description>A powered elevator that opens and links a level below, just like a stairwell - but compact, and it carries colonists in style. The car needs power to descend; if power fails, anyone below can still ride up to safety, so no one is ever trapped. Cannot be deconstructed while colonists are on the level below.</description>
    <thingClass>Strata.Building_ElevatorDown</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/ElevatorDown</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <portal>
      <pocketMapGenerator>Strata_UndergroundLevel</pocketMapGenerator>
      <exitDef>Strata_ElevatorUp</exitDef>
      <pocketMapSize>200</pocketMapSize>
    </portal>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="Strata.CompProperties_StairwellControl"/>
    </comps>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Strata_Elevators</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Elevator up (bottom landing) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_ElevatorUp</defName>
    <label>elevator landing</label>
    <description>The bottom landing of an elevator, leading back up to the level above. It cannot be deconstructed - it is the way home.</description>
    <thingClass>Strata.Building_ElevatorUp</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/ElevatorUp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
        <basePowerConsumption>0</basePowerConsumption>
      </li>
    </comps>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- ============ Exhaust fan (one-way wall vent) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_ExhaustFan</defName>
    <label>exhaust fan</label>
    <description>A powered one-way wall vent. Mount it in a wall with the intake side facing the smoky room; fumes are pulled out the facing side into another room, a duct run, or the open air. Does not work in reverse. Essential for wood or chemfuel generators underground.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/TempControl/Vent</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <blockLight>true</blockLight>
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="Strata.CompProperties_ExhaustVent">
        <ventPower>0.25</ventPower>
        <requiresPower>true</requiresPower>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_Vent</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <building>
      <canPlaceOverWall>true</canPlaceOverWall>
    </building>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Updraft filter (powered shaft vent) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_UpdraftFilter</defName>
    <label>updraft filter</label>
    <description>A powered fan mounted in a stairwell or elevator room. Smoke naturally rises through an open shaft; this filter actively pulls fumes from the landing room and pushes them up to the level above — like a chimney stack for your underground burners. Useless when the shaft is sealed.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/ExhaustFan</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>14</pathCost>
    <fillPercent>0.25</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>80</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="Strata.CompProperties_SmokeUpdraft">
        <risePower>0.25</risePower>
        <requiresPower>true</requiresPower>
      </li>
    </comps>
    <placeWorkers>
      <li>Strata.PlaceWorker_UpdraftFilter</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Smoke louver (passive one-way wall vent) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_SmokeLouver</defName>
    <label>smoke louver</label>
    <description>A passive one-way wall louver. Mount it like a vent with the intake side facing the room to vent; it slowly bleeds fumes out the facing side without power. Weaker than an exhaust fan, but cheap and always on.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/TempControl/Vent</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <blockLight>true</blockLight>
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>20</Steel>
    </costList>
    <comps>
      <li Class="Strata.CompProperties_ExhaustVent">
        <ventPower>0.06</ventPower>
        <requiresPower>false</requiresPower>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_Vent</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <building>
      <canPlaceOverWall>true</canPlaceOverWall>
    </building>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Smoke hole (primitive passive vent, no research) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_SmokeHole</defName>
    <label>smoke hole</label>
    <description>A sod-and-wicker flue packed into a wall opening - the oldest chimney there is. Mount it with the intake side facing the smoky room and fumes slowly seep out the other side. Weaker than machined vents, but it needs no research and nothing but wood, and it keeps a fire-lit room breathable. One-way only.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/TempControl/Vent</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <color>(133,109,78)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <blockLight>true</blockLight>
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>25</WoodLog>
    </costList>
    <comps>
      <li Class="Strata.CompProperties_ExhaustVent">
        <ventPower>0.05</ventPower>
        <requiresPower>false</requiresPower>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_Vent</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <building>
      <canPlaceOverWall>true</canPlaceOverWall>
    </building>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Smoke duct ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_SmokeDuct</defName>
    <label>smoke duct</label>
    <description>A floor duct that routes exhaust from a fan or louver to a distant outdoor louver or open wall. Connect ducts in a line; the run must reach outdoors (or an outdoor-facing vent) to clear smoke from the intake room.</description>
    <thingClass>Strata.Building_SmokeDuct</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/SmokeDuct_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Transmitter</linkType>
      <linkFlags>
        <li>Custom7</li>
      </linkFlags>
      <damageData>
        <rect>(0,0.35,1,0.3)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Strata/Buildings/SmokeDuct_MenuIcon</uiIconPath>
    <uiIconScale>0.7</uiIconScale>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>350</WorkToBuild>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <Steel>10</Steel>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <blueprintGraphicData>
        <texPath>Strata/Buildings/SmokeDuct_Blueprint_Atlas</texPath>
      </blueprintGraphicData>
    </building>
    <comps>
      <li Class="Strata.CompProperties_SmokeDuct"/>
    </comps>
    <constructEffect>ConstructMetal</constructEffect>
    <clearBuildingArea>false</clearBuildingArea>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Shaft power conduit ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_ShaftConduit</defName>
    <label>shaft power conduit</label>
    <description>An optional power junction for running power through a shaft. Build one within a few tiles of a stairwell or elevator: it automatically extends a matching junction down to the landing below, and power flows between the two grids once each level is wired to its junction. Stairwells and elevators already carry power on their own — use this when you need a dedicated tie point away from the shaft footprint.</description>
    <thingClass>Strata.Building_ShaftConduit</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/ShaftConduit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>14</pathCost>
    <fillPercent>0.3</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
        <basePowerConsumption>10</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Strata_ShaftPower</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
