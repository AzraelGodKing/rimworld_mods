<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <JobDef>
    <defName>Strata_HaulToLevel</defName>
    <driverClass>Strata.JobDriver_HaulToLevel</driverClass>
    <reportString>hauling TargetA to another level.</reportString>
    <carryThingAfterJob>true</carryThingAfterJob>
  </JobDef>

  <JobDef>
    <defName>Strata_EscortToPortal</defName>
    <driverClass>Strata.JobDriver_StrataEscortToPortal</driverClass>
    <reportString>escorting TargetB to another level.</reportString>
    <carryThingAfterJob>true</carryThingAfterJob>
  </JobDef>

  <JobDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>Strata_BringBabyToLevel</defName>
    <driverClass>Strata.JobDriver_BringBabyToLevel</driverClass>
    <reportString>carrying TargetA to their crib on another level.</reportString>
    <carryThingAfterJob>true</carryThingAfterJob>
    <dropThingBeforeJob>false</dropThingBeforeJob>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>Strata_BringPrisonerToLevel</defName>
    <driverClass>Strata.JobDriver_BringPrisonerToLevel</driverClass>
    <reportString>carrying prisoner TargetA to bed on another level.</reportString>
    <carryThingAfterJob>true</carryThingAfterJob>
    <dropThingBeforeJob>false</dropThingBeforeJob>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>Strata_CaptureToLevel</defName>
    <driverClass>Strata.JobDriver_BringPrisonerToLevel</driverClass>
    <reportString>capturing TargetA to a prison bed on another level.</reportString>
    <carryThingAfterJob>true</carryThingAfterJob>
    <dropThingBeforeJob>false</dropThingBeforeJob>
    <casualInterruptible>false</casualInterruptible>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>

  <JobDef>
    <defName>Strata_RescueToLevel</defName>
    <driverClass>Strata.JobDriver_RescueToLevel</driverClass>
    <reportString>rescuing TargetA to a bed on another level.</reportString>
    <carryThingAfterJob>true</carryThingAfterJob>
    <dropThingBeforeJob>false</dropThingBeforeJob>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <JobDef MayRequire="Ludeon.RimWorld.Anomaly">
    <defName>Strata_BringEntityToLevel</defName>
    <driverClass>Strata.JobDriver_BringEntityToLevel</driverClass>
    <reportString>carrying TargetA to a holding platform on another level.</reportString>
    <carryThingAfterJob>true</carryThingAfterJob>
    <dropThingBeforeJob>false</dropThingBeforeJob>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

</Defs>
