*.dll
__pycache__/
*.pyc

# Build outputs (mods + tools)
**/obj/
**/bin/

# Vue site build artifacts
site/node_modules/
site/dist/

# Local dumps and art packages — do not commit archives
*.rar
*.zip
# Site download zips are published via GitHub Release, not committed
# (covered by *.zip above)

# Local decompile / reflect scratch (must never re-enter the repo)
Strata/Tools/_decompile_tmp/
Strata/Tools/_reflect_tmp/

# Scratch workspace: decompiled RimWorld / third-party mod source, IL dumps,
# build artifacts. Local-only — republishing decompiled assemblies is not ours
# to do, and these are throwaway anyway.
.tmp/

# Local editor config — not part of the public repo
.cursor/
.claude/

# Local private outputs (never commit)
.local/
.local/**
**/discord*webhook*
