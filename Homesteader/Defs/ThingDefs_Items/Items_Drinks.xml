<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Cider ============ -->
  <ThingDef ParentName="DrugBase">
    <defName>Homesteader_Cider</defName>
    <label>cider</label>
    <description>Fermented fruit cider with a gentle kick. Lifts the mood, and drinking too much leads where drinking too much always leads.</description>
    <graphicData>
      <texPath>Homesteader/Items/Cider</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <rotatable>false</rotatable>
    <stackLimit>25</stackLimit>
    <statBases>
      <DeteriorationRate>0.5</DeteriorationRate>
      <MarketValue>11</MarketValue>
      <Mass>0.3</Mass>
      <Flammability>0.5</Flammability>
      <Nutrition>0.08</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Fluid, Processed, Liquor</foodType>
      <joyKind>Chemical</joyKind>
      <joy>0.17</joy>
      <nurseable>true</nurseable>
      <drugCategory>Social</drugCategory>
      <ingestSound>Ingest_Beer</ingestSound>
      <ingestHoldUsesTable>false</ingestHoldUsesTable>
      <ingestCommandString>Drink {0}</ingestCommandString>
      <ingestReportString>Drinking {0}.</ingestReportString>
      <useEatingSpeedStat>false</useEatingSpeedStat>
      <chairSearchRadius>25</chairSearchRadius>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>AlcoholHigh</hediffDef>
          <severity>0.12</severity>
          <toleranceChemical>Alcohol</toleranceChemical>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>Alcohol</chemical>
        <addictiveness>0.008</addictiveness>
        <minToleranceToAddict>0.25</minToleranceToAddict>
        <existingAddictionSeverityOffset>0.18</existingAddictionSeverityOffset>
        <needLevelOffset>0.9</needLevelOffset>
        <listOrder>11</listOrder>
      </li>
    </comps>
    <thingCategories>
      <li>Drugs</li>
    </thingCategories>
  </ThingDef>

  <!-- ============ Mead ============ -->
  <ThingDef ParentName="DrugBase">
    <defName>Homesteader_Mead</defName>
    <label>mead</label>
    <description>Honey wine fermented the old way. Sweet, strong, and a fine reward after a hard season on the homestead.</description>
    <graphicData>
      <texPath>Homesteader/Items/Mead</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <rotatable>false</rotatable>
    <stackLimit>25</stackLimit>
    <statBases>
      <DeteriorationRate>0.5</DeteriorationRate>
      <MarketValue>15</MarketValue>
      <Mass>0.3</Mass>
      <Flammability>0.5</Flammability>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Fluid, Processed, Liquor</foodType>
      <joyKind>Chemical</joyKind>
      <joy>0.22</joy>
      <nurseable>true</nurseable>
      <drugCategory>Social</drugCategory>
      <ingestSound>Ingest_Beer</ingestSound>
      <ingestHoldUsesTable>false</ingestHoldUsesTable>
      <ingestCommandString>Drink {0}</ingestCommandString>
      <ingestReportString>Drinking {0}.</ingestReportString>
      <useEatingSpeedStat>false</useEatingSpeedStat>
      <chairSearchRadius>25</chairSearchRadius>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>AlcoholHigh</hediffDef>
          <severity>0.18</severity>
          <toleranceChemical>Alcohol</toleranceChemical>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>Alcohol</chemical>
        <addictiveness>0.012</addictiveness>
        <minToleranceToAddict>0.25</minToleranceToAddict>
        <existingAddictionSeverityOffset>0.20</existingAddictionSeverityOffset>
        <needLevelOffset>0.9</needLevelOffset>
        <listOrder>12</listOrder>
      </li>
    </comps>
    <thingCategories>
      <li>Drugs</li>
    </thingCategories>
  </ThingDef>

  <!-- ============ Herbal tea ============ -->
  <ThingDef ParentName="ResourceBase">
    <defName>Homesteader_HerbalTea</defName>
    <label>herbal tea</label>
    <description>A soothing cup brewed from dried homestead herbs. Warms the hands and lifts the spirits without any alcohol.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Homesteader/Items/HerbalTea</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>25</stackLimit>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <DeteriorationRate>1</DeteriorationRate>
      <MarketValue>4</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>0.2</Flammability>
      <Nutrition>0.03</Nutrition>
    </statBases>
    <ingestible>
      <foodType>Processed</foodType>
      <preferability>NeverForNutrition</preferability>
      <joyKind>Gluttonous</joyKind>
      <joy>0.25</joy>
      <nurseable>true</nurseable>
      <ingestSound>Ingest_Beer</ingestSound>
      <ingestCommandString>Drink {0}</ingestCommandString>
      <ingestReportString>Drinking {0}.</ingestReportString>
      <useEatingSpeedStat>false</useEatingSpeedStat>
      <chairSearchRadius>25</chairSearchRadius>
    </ingestible>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
  </ThingDef>

</Defs>
