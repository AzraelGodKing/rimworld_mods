<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThoughtDef>
    <defName>Nemesis_Hunted</defName>
    <workerClass>Nemesis.ThoughtWorker_NemesisHunted</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>hunted</label>
        <description>Someone out there has made me their personal project. I can feel them watching.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Nemesis_HuntedSpike</defName>
    <durationDays>1.5</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.75</stackedEffectMultiplier>
    <stages>
      <li>
        <label>hunted again</label>
        <description>They struck again. The message was for me.</description>
        <baseMoodEffect>-12</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Nemesis_HuntOverTarget</defName>
    <durationDays>8</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>it's finally over</label>
        <description>The hunt is done. I can breathe again.</description>
        <baseMoodEffect>18</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Nemesis_HuntOverColony</defName>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>nemesis gone</label>
        <description>That personal war is finished. The colony feels lighter.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>Nemesis_Nightmare</defName>
    <durationDays>1.2</durationDays>
    <stackLimit>2</stackLimit>
    <stackedEffectMultiplier>0.7</stackedEffectMultiplier>
    <stages>
      <li>
        <label>nemesis nightmare</label>
        <description>I dreamed they were already inside the walls. I woke up tasting copper.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
