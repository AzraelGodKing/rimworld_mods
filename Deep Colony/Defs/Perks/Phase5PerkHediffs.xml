  <!-- B04 chronic trauma -->
  <HediffDef>
    <defName>DC_Hediff_ChronicStress</defName>
    <label>chronic stress</label>
    <description>Untreated trauma that settled into the body. Counseling eases it; neglect worsens it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>0.35</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>disturbed sleep</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.02</offset></li>
        </capMods>
        <statOffsets><RestRateMultiplier>-0.08</RestRateMultiplier></statOffsets>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>hypervigilance</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.04</offset></li>
        </capMods>
        <statOffsets>
          <RestRateMultiplier>-0.12</RestRateMultiplier>
          <MentalBreakThreshold>-0.04</MentalBreakThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>fragile</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.06</offset></li>
        </capMods>
        <statOffsets>
          <RestRateMultiplier>-0.18</RestRateMultiplier>
          <MentalBreakThreshold>-0.08</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

