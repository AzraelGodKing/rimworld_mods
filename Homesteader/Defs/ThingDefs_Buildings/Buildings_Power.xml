<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Compact battery ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_CompactBattery</defName>
    <label>compact battery</label>
    <description>A small battery for storing electricity. Holds less than a full-size battery, but fits in a single cell - handy for tight bases, outposts, and early power grids. Like all batteries, it loses some energy to inefficiency and can short-circuit in the rain.</description>
    <thingClass>Building_Battery</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/CompactBattery</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.40</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>35</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Battery">
        <storedEnergyMax>200</storedEnergyMax>
        <efficiency>0.5</efficiency>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Batteries</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Battery bank ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_BatteryBank</defName>
    <label>battery bank</label>
    <description>A rack of interconnected battery cells with an improved charge controller. Stores a large amount of energy at better efficiency than standalone batteries. Can short-circuit in the rain.</description>
    <thingClass>Building_Battery</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/BatteryBank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.60</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>2600</WorkToBuild>
      <Mass>45</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>180</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Battery">
        <storedEnergyMax>1600</storedEnergyMax>
        <efficiency>0.7</efficiency>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Batteries</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Advanced battery ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_AdvancedBattery</defName>
    <label>advanced battery</label>
    <description>A precision-fabricated battery with laminated cells and a smart charge controller. Stores far more energy than a standard battery and wastes only 10% of the power fed into it. Can short-circuit in the rain.</description>
    <thingClass>Building_Battery</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/AdvancedBattery</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.50</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,2)</size>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Mass>22</Mass>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <Plasteel>25</Plasteel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Battery">
        <storedEnergyMax>900</storedEnergyMax>
        <efficiency>0.9</efficiency>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Fabrication</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Ultratech battery ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_UltratechBattery</defName>
    <label>ultratech battery</label>
    <description>The pinnacle of energy storage: a sealed plasteel vessel around a superconducting core, humming with a faint blue glow. Stores an enormous charge and loses barely 1% of the power fed into it. Can still short-circuit in the rain - even ultratech has limits.</description>
    <thingClass>Building_Battery</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/UltratechBattery</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.65</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>5000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <Plasteel>150</Plasteel>
      <Gold>40</Gold>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Battery">
        <storedEnergyMax>4000</storedEnergyMax>
        <efficiency>0.99</efficiency>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(110,228,235,0)</glowColor>
      </li>
    </comps>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>AdvancedFabrication</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Portable generator ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_PortableGenerator</defName>
    <label>portable generator</label>
    <description>A compact chemfuel-burning generator. Produces a modest 350W from a single cell - less fuel-efficient than a full-size generator, but perfect for outposts, workshops, and cramped bases. Produces some heat.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/PortableGenerator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0.8</Flammability>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-350</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>2.0</fuelConsumptionRate>
        <fuelCapacity>20.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>2</heatPerSecond>
      </li>
    </comps>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Wood-burning generator ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_WoodGenerator</defName>
    <label>wood-burning generator</label>
    <description>A compact generator that burns wood logs instead of chemfuel. Produces 300W from a single cell - ideal for forest homesteads and off-grid workshops. Produces some heat.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/WoodGenerator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Mass>28</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <costList>
      <Steel>90</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-300</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>3.0</fuelConsumptionRate>
        <fuelCapacity>30.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>3</heatPerSecond>
      </li>
    </comps>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_AdvancedHomestead</li>
      <li>Electricity</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
