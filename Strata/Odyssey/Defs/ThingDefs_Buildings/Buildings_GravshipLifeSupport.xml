<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- VGE-inspired life support for Strata gravship decks (no VEF PipeSystem). -->

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_GravshipOxygenTank</defName>
    <label>gravship oxygen tank</label>
    <description>Stores compressed oxygen for Strata gravship underdecks and tower decks. While powered it releases breathable air into the room. Refills from chemfuel or from an open stair umbilical to the host deck when landed (not in vacuum).\n\nGravship-linked levels do not freely replenish oxygen — tanks, pumps, reclaimers, or an open shaft are required.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/OxygenPump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <color>(0.55, 0.78, 0.95)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <fillPercent>0.35</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2800</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Mass>25</Mass>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Plasteel>20</Plasteel>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>80</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>40</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showFuelGizmo>true</showFuelGizmo>
        <initialFuelPercent>0.4</initialFuelPercent>
      </li>
      <li Class="Strata.CompProperties_GravshipOxygenTank">
        <maxStored>40</maxStored>
        <releasePerRareTick>0.012</releasePerRareTick>
        <consumePerRareTick>0.08</consumePerRareTick>
        <umbilicalRefillPerRareTick>0.05</umbilicalRefillPerRareTick>
      </li>
    </comps>
    <designationCategory>Odyssey</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>BasicGravtech</li>
      <li>Strata_LifeSupport</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>Strata.PlaceWorker_GravshipLifeSupport</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_GravshipOxygenReclaimer</defName>
    <label>gravship oxygen reclaimer</label>
    <description>A powered scrubber that generates oxygen for gravship life support. Prefer placing near an oxygen tank — output fills the nearest tank within 12 cells; otherwise it bleeds slowly into the room air.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/CO2Pump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <color>(0.45, 0.85, 0.75)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <fillPercent>0.35</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>3200</WorkToBuild>
      <Flammability>0.3</Flammability>
    </statBases>
    <costList>
      <Steel>70</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Plasteel>15</Plasteel>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>220</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="Strata.CompProperties_GravshipOxygenReclaimer">
        <producePerRareTick>0.12</producePerRareTick>
      </li>
    </comps>
    <designationCategory>Odyssey</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>BasicGravtech</li>
      <li>Strata_LifeSupport</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>Strata.PlaceWorker_GravshipLifeSupport</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_GravshipHeatsink</defName>
    <label>gravship heatsink</label>
    <description>Absorbs waste heat from gravship launches and bleeds it into the surrounding room as warmth. Place on the ship deck or linked Strata underdeck. Without heatsinks, launch heat dumps straight into ship rooms.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/LimeScrubber</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <color>(0.95, 0.55, 0.35)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2600</WorkToBuild>
      <Flammability>0.1</Flammability>
    </statBases>
    <costList>
      <Steel>90</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Plasteel>10</Plasteel>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="Strata.CompProperties_GravshipHeatsink">
        <maxHeat>80</maxHeat>
        <dissipatePerHour>10</dissipatePerHour>
        <heatPushPerSecond>14</heatPushPerSecond>
      </li>
    </comps>
    <designationCategory>Odyssey</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>BasicGravtech</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>Strata.PlaceWorker_GravshipLifeSupport</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_GravshipHeatsinkLarge</defName>
    <label>large gravship heatsink</label>
    <description>A heavier radiator bank for long jumps. Stores more launch heat and dumps it faster once powered.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/LimeScrubber</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1)</drawSize>
      <color>(0.95, 0.4, 0.28)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.45</fillPercent>
    <rotatable>true</rotatable>
    <size>(2,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>320</MaxHitPoints>
      <WorkToBuild>4500</WorkToBuild>
      <Flammability>0.1</Flammability>
    </statBases>
    <costList>
      <Steel>160</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Plasteel>30</Plasteel>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="Strata.CompProperties_GravshipHeatsink">
        <maxHeat>220</maxHeat>
        <dissipatePerHour>22</dissipatePerHour>
        <heatPushPerSecond>24</heatPushPerSecond>
      </li>
    </comps>
    <designationCategory>Odyssey</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>BasicGravtech</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>Strata.PlaceWorker_GravshipLifeSupport</li>
    </placeWorkers>
  </ThingDef>

</Defs>
