<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>Strata_SmokeInhalation</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>smoke inhalation</label>
    <description>Combustion fumes breathed in an unventilated room. It clears with fresh air, but lingering in thick smoke chokes the lungs - and enough of it is fatal.</description>
    <lethalSeverity>1.0</lethalSeverity>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>mild</label>
        <minSeverity>0</minSeverity>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>coughing</label>
        <minSeverity>0.3</minSeverity>
        <painOffset>0.10</painOffset>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>choking</label>
        <minSeverity>0.6</minSeverity>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.25</painOffset>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.50</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.35</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
