<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WaveSurvivalReforged</RootNamespace>
    <AssemblyName>WaveSurvivalReforged</AssemblyName>
    <!-- 1.7. Building WaveSurvivalReforged.csproj does not overwrite this DLL. -->
    <OutputPath>../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);RIMWORLD_1_7</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- No Harmony: link only the Common files that do not need it. -->
    <Compile Include="..\..\Common\ModPack.cs" Link="Common\ModPack.cs" />
    <Compile Include="..\..\Common\ModVersionLog.cs" Link="Common\ModVersionLog.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4998-unstable" />
  </ItemGroup>
</Project>
