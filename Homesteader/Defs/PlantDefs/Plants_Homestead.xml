  <!-- ============ Flax ============ -->
  <ThingDef ParentName="PlantBase">
    <defName>Homesteader_Plant_Flax</defName>
    <label>flax plant</label>
    <description>A blue-flowered fiber crop. Harvested stalks are broken into flax fiber for the spinning wheel. Grows best after orchard craft or textiles research.</description>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>1.3</Flammability>
      <Nutrition>0.15</Nutrition>
    </statBases>
