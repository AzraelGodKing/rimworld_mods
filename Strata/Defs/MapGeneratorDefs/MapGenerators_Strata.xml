<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <MapGeneratorDef>
    <defName>Strata_UndergroundLevel</defName>
    <isUnderground>true</isUnderground>
    <roofDef>RoofRockThick</roofDef>
    <disableShadows>true</disableShadows>
    <renderWorld>false</renderWorld>
    <pocketMapProperties>
      <biome>Strata_Underground</biome>
      <temperature>10</temperature>
      <destroyOnParentMapAbandoned>true</destroyOnParentMapAbandoned>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
    <genSteps>
      <li>Strata_SolidRock</li>
      <li>Strata_CarveWarren</li>
      <li>Strata_HiddenChambers</li>
      <li>Strata_BiomesCavernFeatures</li>
      <li>Strata_DbhGroundwater</li>
      <li>Strata_PlaceCaveExit</li>
      <li>Strata_Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>Strata_SolidRock</defName>
    <order>100</order>
    <genStep Class="Strata.GenStep_SolidRock"/>
  </GenStepDef>

  <!-- Geothermal and gas chambers sealed in the rock, found by mining. -->
  <GenStepDef>
    <defName>Strata_HiddenChambers</defName>
    <order>300</order>
    <genStep Class="Strata.GenStep_HiddenChambers"/>
  </GenStepDef>

  <GenStepDef>
    <defName>Strata_BiomesCavernFeatures</defName>
    <order>320</order>
    <genStep Class="Strata.GenStep_BiomesCavernFeatures"/>
  </GenStepDef>

  <GenStepDef>
    <defName>Strata_DbhGroundwater</defName>
    <order>350</order>
    <genStep Class="Strata.GenStep_DbhGroundwater"/>
  </GenStepDef>

  <GenStepDef>
    <defName>Strata_PlaceCaveExit</defName>
    <order>500</order>
    <genStep Class="Strata.GenStep_PlaceLevelExit"/>
  </GenStepDef>

  <!-- Fog everything but the arrival chamber so hidden chambers stay hidden
       until a miner breaks through (vanilla unfogs on mineable despawn). -->
  <GenStepDef>
    <defName>Strata_Fog</defName>
    <order>700</order>
    <genStep Class="Strata.GenStep_StrataFog"/>
  </GenStepDef>

  <GenStepDef>
    <defName>Strata_AncientColonyStairwell</defName>
    <!-- After vanilla FindPlayerStartSpot (850); was 650 and ran too early. -->
    <order>880</order>
    <genStep Class="Strata.GenStep_AncientColonyStairwell"/>
  </GenStepDef>

</Defs>
