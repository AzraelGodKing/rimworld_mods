<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Grain mill ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_GrainMill</defName>
    <label>grain mill</label>
    <description>A hand-cranked stone mill for grinding raw plants and grain into flour. No power required.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/GrainMill</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.35</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <WoodLog>45</WoodLog>
      <Steel>10</Steel>
    </costList>
    <recipes>
      <li>Homesteader_MillFlour</li>
      <li>Homesteader_MillSugar</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_FarmsteadCrafting</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Butter churn ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_ButterChurn</defName>
    <label>butter churn</label>
    <description>A wooden churn for skimming cream from milk and turning that cream into butter. Simple farm-to-table craftsmanship.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/ButterChurn</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.3</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>0.6</Flammability>
    </statBases>
    <costList>
      <WoodLog>35</WoodLog>
    </costList>
    <recipes>
      <li>Homesteader_ChurnButter</li>
      <li>Homesteader_SkimCream</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_FarmsteadCrafting</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Cheese press ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_CheesePress</defName>
    <label>cheese press</label>
    <description>A weighted wooden press for turning salted cream curds into wheels of long-keeping farmhouse cheese.</description>
