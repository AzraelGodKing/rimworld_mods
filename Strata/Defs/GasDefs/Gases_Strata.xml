<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The atmosphere simulation's channels. Every ventilation tool (vents,
       louvers, smoke holes, ducts, fans, updraft filters, seals, and the
       ventilation guarantee) applies to every gas automatically - these defs
       only decide color, buoyancy, persistence, harm, fire, and extraction. -->

  <!-- Combustion smoke: the original sim, unchanged numbers. -->
  <Strata.StrataGasDef>
    <defName>Strata_Smoke</defName>
    <label>smoke</label>
    <overlayLabel>smoke</overlayLabel>
    <description>Combustion fumes from burners and open flames. Rises through unsealed shafts and chokes anyone lingering in it.</description>
    <overlayColor>(0.04, 0.04, 0.05)</overlayColor>
    <buoyant>true</buoyant>
    <passiveLeak>0.02</passiveLeak>
    <harmHediff>Strata_SmokeInhalation</harmHediff>
    <harmThreshold>0.15</harmThreshold>
    <severityGain>0.006</severityGain>
    <severityDecay>0.03</severityDecay>
    <throwsMotes>true</throwsMotes>
    <moteThreshold>0.2</moteThreshold>
  </Strata.StrataGasDef>

  <!-- Foul deep gas: heavier than air, so it pools on the level it leaks
       into instead of riding shafts upward. Persistent - a sealed pocket
       keeps its pressure forever. Toxic, explosive, and worth money. -->
  <Strata.StrataGasDef>
    <defName>Strata_DeepGas</defName>
    <label>deep gas</label>
    <overlayLabel>deep gas</overlayLabel>
    <description>Foul flammable gas trapped in the rock. It pools where it leaks, poisons anyone breathing it, and explodes on contact with open flame - but a capped vent will pump it into fuel.</description>
    <overlayColor>(0.30, 0.44, 0.16)</overlayColor>
    <buoyant>false</buoyant>
    <passiveLeak>0</passiveLeak>
    <harmHediff>Strata_GasInhalation</harmHediff>
    <harmThreshold>0.12</harmThreshold>
    <severityGain>0.008</severityGain>
    <severityDecay>0.025</severityDecay>
    <flammable>true</flammable>
    <ignitionDensity>0.35</ignitionDensity>
    <extractable>true</extractable>
  </Strata.StrataGasDef>

  <!-- Breathable air on deep levels: lighter than CO₂, rises through shafts.
       Pawns consume it and suffocate when it falls too low. -->
  <Strata.StrataGasDef>
    <defName>Strata_Oxygen</defName>
    <label>oxygen</label>
    <overlayLabel>O₂</overlayLabel>
    <description>Breathable air trapped in excavated levels. It rises through unsealed shafts; without ventilation, colonists slowly use it up.</description>
    <overlayColor>(0.08, 0.14, 0.28)</overlayColor>
    <buoyant>true</buoyant>
    <passiveLeak>0</passiveLeak>
    <harmHediff>Strata_Hypoxia</harmHediff>
    <harmThreshold>0.12</harmThreshold>
    <severityGain>0.007</severityGain>
    <severityDecay>0.035</severityDecay>
    <harmWhenBelow>true</harmWhenBelow>
  </Strata.StrataGasDef>

  <!-- Exhaled waste gas: heavier than air, pools low and sinks down shafts. -->
  <Strata.StrataGasDef>
    <defName>Strata_CarbonDioxide</defName>
    <label>carbon dioxide</label>
    <overlayLabel>CO₂</overlayLabel>
    <description>Exhaled breath and combustion waste. It pools on the floor, sinks through stairwells to deeper levels, and becomes toxic in concentration.</description>
    <overlayColor>(0.18, 0.20, 0.22)</overlayColor>
    <buoyant>false</buoyant>
    <passiveLeak>0</passiveLeak>
    <harmHediff>Strata_CO2Exposure</harmHediff>
    <harmThreshold>0.18</harmThreshold>
    <severityGain>0.006</severityGain>
    <severityDecay>0.03</severityDecay>
  </Strata.StrataGasDef>

</Defs>
