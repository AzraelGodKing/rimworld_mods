  <!-- ============ Smoke hole (primitive passive vent, no research) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_SmokeHole</defName>
    <label>smoke hole</label>
    <description>A sod-and-wicker flue packed into a wall opening - the oldest chimney there is. Mount it with the intake side facing the smoky room and fumes slowly seep out the other side. Weaker than machined vents, but it needs no research and nothing but wood, and it keeps a fire-lit room breathable. One-way only.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/SmokeHole</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <blockLight>true</blockLight>
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>25</WoodLog>
    </costList>
    <comps>
      <li Class="Strata.CompProperties_ExhaustVent">
        <ventPower>0.05</ventPower>
        <requiresPower>false</requiresPower>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_Vent</li>
      <li>Strata.PlaceWorker_OneWayVent</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <building>
      <canPlaceOverWall>true</canPlaceOverWall>
    </building>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Gas pipe (Strata atmosphere routing) ============ -->
  <ThingDef Name="Strata_GasPipeBase" Abstract="True" ParentName="BuildingBase">
    <thingClass>Strata.Building_GasPipe</thingClass>
    <description>A metal pipe run on the conduit layer. Connects like power conduits and moves every Strata gas (smoke, oxygen, deep gas, and the rest) between rooms on the same run. Fans and louvers can exhaust into a pipe; the run must reach open air to vent outside.</description>
    <uiIconScale>0.7</uiIconScale>
    <drawerType>MapMeshOnly</drawerType>
    <drawStyleCategory>Conduits</drawStyleCategory>
    <altitudeLayer>Conduits</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <rotatable>false</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>350</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <Steel>10</Steel>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <paintable>true</paintable>
    </building>
    <placeWorkers>
      <li>Strata.PlaceWorker_GasPipe</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <constructEffect>ConstructMetal</constructEffect>
    <clearBuildingArea>false</clearBuildingArea>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>true</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
  </ThingDef>

