<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Lost floor diary (story item) ============ -->
  <ThingDef ParentName="ResourceBase">
    <defName>Strata_LostDiary</defName>
    <label>miner's diary</label>
    <description>A worn leather diary left on a sealed floor by people who dug down long ago. Select it and press Read.</description>
    <graphicData>
      <texPath>Strata/Items/LostDiary</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.75,0.75)</drawSize>
    </graphicData>
    <stackLimit>1</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>40</MarketValue>
      <Mass>0.3</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeability>Sellable</tradeability>
    <comps>
      <li>
        <compClass>Strata.CompLostDiary</compClass>
      </li>
    </comps>
  </ThingDef>

</Defs>
