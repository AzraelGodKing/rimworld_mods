  <!-- ============ Static discharge pylon ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Stormproof_StaticPylon</defName>
    <label>static discharge pylon</label>
    <description>A defensive pylon that runs exclusively on bottled lightning. Every shock drains 50 Wd of stored strike energy from a storm capacitor bank on the same power net, stunning and searing hostile raiders and mechanoids in a small radius with electrical burns. No capacitor charge, no zap - keep your storm spires fed.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Stormproof/Buildings/StaticPylon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,2)</drawSize>
      <drawOffset>(0,0,0.5)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.35</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <specialDisplayRadius>6.9</specialDisplayRadius>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <Gold>5</Gold>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="Stormproof.CompProperties_StaticPylon">
        <dischargeRadius>6.9</dischargeRadius>
        <dischargeIntervalTicks>180</dischargeIntervalTicks>
        <stunTicks>120</stunTicks>
        <energyPerShock>50</energyPerShock>
        <damagePerShock>6</damagePerShock>
      </li>
    </comps>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Stormproof_FlareShielding</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Fallout scrubber ============ -->
