  <ThingDef ParentName="BuildingBase">
    <defName>Strata_SteamCondenser</defName>
    <label>steam condenser</label>
    <description>Cooled plates. Steam from a geyser chamber or volcanic warren hits them and drops out as water instead of scalding haze.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/OxygenPump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <color>(0.70,0.80,0.90)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
