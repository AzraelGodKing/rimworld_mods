{"nodes": [{"id": "docs_ideas_living_world_living_world", "label": "Living World", "file_type": "document", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vanilla settlements are static pins and the world only moves when an incident targets the player, so Living World is the off-map layer that makes factions feel inhabited without stealing systems owned by Nemesis, Deep Colony or Homesteader. Package LivingWorld / azraelgodking.livingworld; Phases 1-2 shipped."}, {"id": "docs_ideas_living_world_pitch", "label": "The rim keeps happening when you are not looking", "file_type": "rationale", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Player fantasy is 'this planet has politics and history, my colony is one actor in it', delivered through rumor, radio and neighbors rather than a second storyteller dumping threat points."}, {"id": "docs_ideas_living_world_non_goals", "label": "Living World non-goals", "file_type": "rationale", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No simulated NPC colony rooms or research, no real-time AI battles beyond abstract resolve rolls, no storyteller replacement, and no ownership of named antagonists, player goodwill, farm brand, weather, columns or romance. Test: if a feature is about your named foe, your goodwill sheet or your farm brand, it does not go here."}, {"id": "docs_ideas_living_world_ownership_matrix", "label": "Series ownership matrix (hard rule)", "file_type": "rationale", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each feature has exactly one owning mod so the series does not grow two implementations of the same system; Living World owns world news, settlement agency, NPC politics and their fallout, and nothing else."}, {"id": "docs_ideas_living_world_emit_consume_contract", "label": "Emit / consume contract", "file_type": "rationale", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Living World emits structured world events and siblings consume them through fail-open soft hooks; Living World never reimplements goodwill math or nemesis hunt state, and every hook no-ops when either side is missing."}, {"id": "docs_ideas_living_world_gamecomponent_livingworld", "label": "GameComponent_LivingWorld", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds the slow tick, options cache, chronicle, diplomacy table and morph cooldowns; all state lives here so clearing the mod mid-save cannot brick a game (tolerant scribe)."}, {"id": "docs_ideas_living_world_core_loop", "label": "Slow world tick core loop", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Targets 1-2 resolutions per in-game day (every 5-15k ticks), picks a small candidate budget, rolls one micro-event, appends to the chronicle, decides visibility, then notifies soft consumers with plain data; workers never call Verse from the ThreadPool so the sim stays main-thread and cheap."}, {"id": "docs_ideas_living_world_worldevent", "label": "WorldEvent", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_living_world_factionpairstate", "label": "FactionPairState", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tone (Peace / Tension / War / Alliance) plus intensity and lastResolveTick per unordered non-player faction pair; an O(factions squared) table is acceptable at vanilla faction counts with defeated/insect/mech filtered out."}, {"id": "docs_ideas_living_world_settlementmood", "label": "SettlementMood", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_living_world_livingworldsignals", "label": "LivingWorldSignals soft event bus", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A static OnEvent (or Harmony-free reflection entry) siblings register into when present, so consumers need no hard assembly dependency on Living World."}, {"id": "docs_ideas_living_world_chronicle", "label": "Chronicle (ring-buffer world history)", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bounded 64-128 event ring buffer scribed in the game component keeps history durable without unbounded save growth; Nemesis taunts, Homesteader Kats Effect and Stormproof weather letters stay in their own mods."}, {"id": "docs_ideas_living_world_hear_rules", "label": "Player hear rules (anti-spam gates)", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stackable gates (prior contact, proximity, powered comms, allied involvement, always-major severity) mean the player only hears about factions and places they already know; default verbosity Medium, Low major-only, High most chronicle rows."}, {"id": "docs_ideas_living_world_settlement_morph", "label": "Settlement morph", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mutates presentation and membership (prosperity drift, epithet, shrink/abandon, grow/outpost, ownership flip) under guards: never the player's tile or settlements, yearly caps, per-settlement cooldown, and prefer factions with 2+ settlements when abandoning."}, {"id": "docs_ideas_living_world_faction_diplomacy", "label": "Faction-to-faction diplomacy tone layer", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vanilla NPC goodwill exists but rarely shows, so an explicit tone layer drives visible resolves (friction, skirmish, cool-off, battle, white peace, pact, betrayal); player impact stays indirect and numeric player goodwill remains Deep Colony's job."}, {"id": "docs_ideas_living_world_fallout_incidents", "label": "Fallout incidents", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refugee caravans, pass-through warbands, aid/sell opportunities and trade blackouts fire when war or morph severity warrants; LW-timed fires are preferred over threat-category spam."}, {"id": "docs_ideas_living_world_refugee_caravan", "label": "Refugee caravan incident", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_living_world_pass_through_warband", "label": "Pass-through warband", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flagged a balance hazard: hostile to their enemy with carefully tuned player relations, so it needs point caps, long MTB and a cautious default."}, {"id": "docs_ideas_living_world_trade_blackout", "label": "Trade blackout", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_living_world_generic_war_sites", "label": "Generic war sites", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Battlefield debris, refugee camps and contested outposts are war-keyed, never clones of Nemesis hunt-keyed false-lead camps; a soft tile check stops two special sites stacking on one cell."}, {"id": "docs_ideas_living_world_inter_settlement_traffic", "label": "Inter-settlement traffic (parked)", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deferred because chronicle, morph and diplomacy already sell 'the world is alive'; v1 ships without it."}, {"id": "docs_ideas_living_world_dc_consumer_contract", "label": "Deep Colony consumer contract", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LW emits visible-war and ally-disaster signals; Deep Colony maps them onto its existing AddFactionDrift / FactionRepUtility and remains the single source of truth for player goodwill."}, {"id": "docs_ideas_living_world_nemesis_peer_contract", "label": "Nemesis peer contract", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nemesis may listen (faction crushed or fled implies escalate or go dormant) but never reads LW to spawn personal camps; on tile conflict Nemesis site ownership wins and LW skips or offsets."}, {"id": "docs_ideas_living_world_homesteader_consumer_contract", "label": "Homesteader consumer contract", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Famine and refugee news may add keyed flavor lines only; farmstand, festival and the Diggo supplier are explicitly not ported into Living World."}, {"id": "docs_ideas_living_world_slice1", "label": "Slice 1 \u2014 world news + settlement morph", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acceptance: over one in-game year on a medium world the player sees multiple non-spam letters and at least one map-visible settlement change, without LW touching player goodwill math."}, {"id": "docs_ideas_living_world_slice2", "label": "Slice 2 \u2014 faction wars / diplomacy", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acceptance: two NPC factions can enter War with no player involvement, settlements show fallout, refugees may arrive, and goodwill changes only if Deep Colony is present and listening."}, {"id": "docs_ideas_living_world_slice3_nemesis", "label": "Slice 3 \u2014 Nemesis world sites (Nemesis-owned)", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hunt base / false-lead arc and multi-faction antagonists (one per hostile faction, global cap 1-2) belong entirely to Nemesis; Living World only provides optional listen hooks and no shared warlord table."}, {"id": "docs_ideas_living_world_completion_sequence", "label": "Dependency-ordered completion sequence", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steps are sorted by dependency rather than by which roadmap file they live in, with parallel tracks marked, so no step starts before its prerequisites are done."}, {"id": "docs_ideas_living_world_phase1_lw0_lw5", "label": "Phase 1 LW0-LW5 (Living World foundation)", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cut the package, add the component and ring buffer, hear-rules and letters, a morph prototype and the soft bus, then morph polish; all marked Done, giving a thin playable v1 before diplomacy."}, {"id": "docs_ideas_living_world_phase2_lw6_lw8", "label": "Phase 2 LW6-LW8 + DC1 (wars and fallout)", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FactionPairState resolves, refugee fallout, the Deep Colony bus consumer and war polish (concurrent war caps, white peace, rare alliance/betrayal, blackout, cautious warband, war sites with Nemesis tile avoidance); all marked Done."}, {"id": "docs_ideas_living_world_phase3_consumers", "label": "Phase 3 sibling consumers and Nemesis layer", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HS1, N1-N4 can run in parallel after their dependencies and must not invent LW systems; N4 personal polish has no LW dependency at all."}, {"id": "docs_ideas_living_world_phase4_series", "label": "Phase 4 LW9 / LW10 / Azrael series steps", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_living_world_azrael_storyteller", "label": "Azrael storyteller weighting (series-owned)", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weights LW fallout and sibling incidents at low threat cost but does not replace LW's silent sim tick, keeping it meta rather than a system owner."}, {"id": "docs_ideas_living_world_v1_cut_list", "label": "Living World v1 cut list", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In: chronicle, morph with caps, faction tones, refugee fallout, soft bus stubs, options and dev tools. Out: traffic visualization, opportunity quests, war-site loot polish, the Azrael storyteller and any Nemesis personal site defs."}, {"id": "docs_ideas_living_world_balance_spam_guards", "label": "Balance and spam guards", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global letters per quadrum, 1-3 concurrent wars, a yearly morph budget and long fallout MTBs keep an always-running sim from drowning the player."}, {"id": "docs_ideas_living_world_open_questions", "label": "Living World open questions", "file_type": "concept", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deferred to playtest, not doc blockers: whether prosperity biases trader stock, separate morph MTBs per faction type, disabling morph on Odyssey gravship worlds, default-off warbands on high difficulty, and chronicle UI versus letters-only for the first release."}, {"id": "docs_ideas_living_world_living_world_docs_page", "label": "Unlisted living-world.html docs page", "file_type": "document", "source_file": "docs/ideas/living-world.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "noindex and deliberately not on the public hub while the mod is pre-release."}], "edges": [{"source": "docs_ideas_living_world_living_world", "target": "docs_ideas_living_world_pitch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_non_goals", "target": "docs_ideas_living_world_living_world", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_ownership_matrix", "target": "docs_ideas_living_world_non_goals", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_ownership_matrix", "target": "docs_ideas_deep_colony_updates_deep_colony", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_ownership_matrix", "target": "docs_ideas_homesteader_updates_homesteader", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_ownership_matrix", "target": "strata_steamdescription_strata", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_emit_consume_contract", "target": "docs_ideas_living_world_livingworldsignals", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_gamecomponent_livingworld", "target": "docs_ideas_living_world_core_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_gamecomponent_livingworld", "target": "docs_ideas_living_world_chronicle", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_gamecomponent_livingworld", "target": "docs_ideas_living_world_factionpairstate", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_gamecomponent_livingworld", "target": "docs_ideas_living_world_settlement_morph", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_chronicle", "target": "docs_ideas_living_world_worldevent", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_hear_rules", "target": "docs_ideas_living_world_worldevent", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_core_loop", "target": "docs_ideas_living_world_hear_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_core_loop", "target": "docs_ideas_living_world_livingworldsignals", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_settlement_morph", "target": "docs_ideas_living_world_settlementmood", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_faction_diplomacy", "target": "docs_ideas_living_world_factionpairstate", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_faction_diplomacy", "target": "docs_ideas_living_world_fallout_incidents", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_faction_diplomacy", "target": "docs_ideas_living_world_generic_war_sites", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/living-world.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_living_world_faction_diplomacy", "target": "docs_ideas_living