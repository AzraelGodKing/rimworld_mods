<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <MapGeneratorDef>
    <defName>Strata_UndergroundLevel</defName>
    <isUnderground>true</isUnderground>
    <roofDef>RoofRockThick</roofDef>
    <disableShadows>true</disableShadows>
    <renderWorld>false</renderWorld>
    <pocketMapProperties>
      <biome>Strata_Underground</biome>
      <temperature>10</temperature>
      <destroyOnParentMapAbandoned>true</destroyOnParentMapAbandoned>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
    <genSteps>
      <li>Strata_SolidRock</li>
      <li>Strata_DeepPockets</li>
      <li>Strata_DbhGroundwater</li>
      <li>Strata_PlaceCaveExit</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>Strata_SolidRock</defName>
    <order>100</order>
    <genStep Class="Strata.GenStep_SolidRock"/>
  </GenStepDef>

  <GenStepDef>
    <defName>Strata_DeepPockets</defName>
    <order>120</order>
    <genStep Class="Strata.GenStep_DeepPockets"/>
  </GenStepDef>

  <GenStepDef>
    <defName>Strata_DbhGroundwater</defName>
    <order>150</order>
    <genStep Class="Strata.GenStep_DbhGroundwater"/>
  </GenStepDef>

  <GenStepDef>
    <defName>Strata_PlaceCaveExit</defName>
    <order>500</order>
    <genStep Class="Strata.GenStep_PlaceLevelExit"/>
  </GenStepDef>

</Defs>
