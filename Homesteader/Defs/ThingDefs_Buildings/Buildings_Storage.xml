<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Storage crate ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_StorageCrate</defName>
    <label>storage crate</label>
    <description>A sturdy wooden crate that holds up to three stacks of items. Its lid keeps the contents from deteriorating, even outdoors.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/StorageCrate</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.45</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>450</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>35</WoodLog>
    </costList>
    <building>
      <storageGroupTag>HomesteaderStorage</storageGroupTag>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <maxItemsInCell>3</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <categories>
            <li>Root</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <categories>
            <li>Root</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Homesteader_Storage</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Storage barrel ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_StorageBarrel</defName>
    <label>storage barrel</label>
    <description>A lidded wooden barrel for storing food and drink. Holds up to three stacks and keeps them from deteriorating in the weather. It cannot slow spoilage - keep perishables cool or preserve them first.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/StorageBarrel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.45</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Mass>7</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>30</WoodLog>
    </costList>
    <building>
      <storageGroupTag>HomesteaderStorage</storageGroupTag>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <maxItemsInCell>3</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <categories>
            <li>Foods</li>
            <li>Drugs</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <categories>
            <li>Foods</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Homesteader_Storage</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Pallet ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_Pallet</defName>
    <label>pallet</label>
    <description>A simple wooden pallet that keeps two stacks of goods off the ground, protecting them from deterioration. Cheap enough to line an entire yard with. Can hold anything, including stone chunks.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/Pallet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>10</pathCost>
    <fillPercent>0.10</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Mass>4</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>15</WoodLog>
    </costList>
    <building>
      <storageGroupTag>HomesteaderStorage</storageGroupTag>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <maxItemsInCell>2</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <categories>
            <li>Root</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Low</priority>
        <filter>
          <categories>
            <li>Root</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Homesteader_Storage</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Ingredient barrel ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_IngredientBarrel</defName>
    <label>ingredient barrel</label>
    <description>A lidded barrel sized for kitchen staples: raw meat, eggs, and milk. Holds three stacks and keeps them from deteriorating outdoors.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/IngredientBarrel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.45</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>380</WorkToBuild>
      <Mass>7</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>30</WoodLog>
    </costList>
    <building>
      <storageGroupTag>HomesteaderStorage</storageGroupTag>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <maxItemsInCell>3</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <categories>
            <li>MeatRaw</li>
            <li>EggsUnfertilized</li>
            <li>EggsFertilized</li>
          </categories>
          <thingDefs>
            <li>Milk</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
          <thingDefs>
            <li>Milk</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Homesteader_Storage</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_PrimitiveHomestead</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Hayloft ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_Hayloft</defName>
    <label>hayloft</label>
    <description>An open wooden loft for bulk farm storage. Holds eight stacks of hay, raw plants, and smokeleaf (four per cell on a 2×1 footprint), sheltered from the weather.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/Hayloft</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.35</fillPercent>
    <rotatable>true</rotatable>
    <size>(2,1)</size>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>550</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>50</WoodLog>
    </costList>
    <building>
      <storageGroupTag>HomesteaderStorage</storageGroupTag>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <maxItemsInCell>4</maxItemsInCell>
      <fixedStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <thingDefs>
            <li>Hay</li>
          </thingDefs>
          <categories>
            <li>PlantFoodRaw</li>
            <li>Drugs</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Normal</priority>
        <filter>
          <thingDefs>
            <li>Hay</li>
          </thingDefs>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Homesteader_Storage</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_PrimitiveHomestead</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Large storage crate ============ -->
