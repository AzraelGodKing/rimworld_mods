<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Barley ============ -->
  <ThingDef ParentName="PlantBase">
    <defName>Homesteader_Plant_Barley</defName>
    <label>barley plant</label>
    <description>A hardy cereal grain that tolerates cool climates. Harvested barley can be milled into flour, cooked into porridge, or brewed.</description>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Flammability>1.3</Flammability>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Homesteader/Plants/BarleyPlant</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <ingestible>
      <foodType>Plant</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.6</fertilitySensitivity>
      <growDays>7</growDays>
      <sowMinSkill>3</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <visualSizeRange>0.3~1.05</visualSizeRange>
      <topWindExposure>0.15</topWindExposure>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>Homesteader_RawBarley</harvestedThingDef>
      <harvestYield>11</harvestYield>
      <dieIfLeafless>true</dieIfLeafless>
      <maxMeshCount>4</maxMeshCount>
      <blockAdjacentSow>false</blockAdjacentSow>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>
    </plant>
  </ThingDef>

