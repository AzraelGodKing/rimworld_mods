{"nodes": [{"id": "docs_versioning_modversion", "label": "modVersion in About.xml", "file_type": "concept", "source_file": "docs/VERSIONING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single player-facing version: RimWorld shows it in the mod list and Player.log prints it on load, which is what bug reports are keyed to."}, {"id": "docs_versioning_when_to_bump", "label": "When to bump (ship only)", "file_type": "rationale", "source_file": "docs/VERSIONING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bump only when shipping Workshop/Nexus/versioned GitHub, never per PR and never inside CI, because Release & Publish reads whatever is already in About.xml; changelog.txt holds only the new version and CI fails if a version has no changelog block."}, {"id": "docs_versioning_build_stamp", "label": "Build stamp naming rule", "file_type": "rationale", "source_file": "docs/VERSIONING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stamps in Player.log and changelog.txt are short feature names like shared-rooms-v1; Linear ids (AZR-xx) must never appear in a stamp."}, {"id": "docs_versioning_three_github_artifacts", "label": "Three GitHub artifact kinds", "file_type": "concept", "source_file": "docs/VERSIONING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "latest stays mutable so site buttons keep a stable URL, snapshots are immutable so players can roll back a bad latest, and versioned tags exist so a Workshop drop has a named zip that is never overwritten."}, {"id": "docs_versioning_latest_tag", "label": "Rolling latest tag", "file_type": "concept", "source_file": "docs/VERSIONING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contri