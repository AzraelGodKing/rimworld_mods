<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Beeswax candle ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_BeeswaxCandle</defName>
    <label>beeswax candle</label>
    <description>A fat, slow-burning candle rendered from beehive wax. Softer light than an oil lamp, but it asks nothing of the still or the power grid - just keep the bees happy.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/BeeswaxCandle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>15</pathCost>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Mass>1.5</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>4</Beauty>
    </statBases>
    <costList>
      <WoodLog>5</WoodLog>
      <Homesteader_Beeswax>4</Homesteader_Beeswax>
    </costList>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.15</fuelConsumptionRate>
        <fuelCapacity>4.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>Homesteader_Beeswax</li>
          </thingDefs>
        </fuelFilter>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(252,200,130,0)</glowColor>
      </li>
      <li Class="CompProperties_FireOverlay">
        <fireSize>0.15</fireSize>
        <offset>(0,0,0.2)</offset>
      </li>
    </comps>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_HomesteadBrewing</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Nesting box ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_NestingBox</defName>
    <label>nesting box</label>
    <description>A snug straw-lined box for small animals to sleep in. Warmer and far more comfortable than bare ground - the hens seem particularly fond of it.</description>
    <thingClass>Building_Bed</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/NestingBox</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.2</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <defaultPlacingRot>South</defaultPlacingRot>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>450</WorkToBuild>
      <Mass>4</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
      <BedRestEffectiveness>1.0</BedRestEffectiveness>
      <Comfort>0.7</Comfort>
    </statBases>
    <costList>
      <WoodLog>25</WoodLog>
      <Hay>10</Hay>
    </costList>
    <building>
      <bed_showSleeperBody>true</bed_showSleeperBody>
      <bed_humanlike>false</bed_humanlike>
      <bed_maxBodySize>0.6</bed_maxBodySize>
    </building>
    <comps>
      <li Class="CompProperties_AssignableToPawn">
        <compClass>CompAssignableToPawn_Bed</compClass>
        <drawAssignmentOverlay>false</drawAssignmentOverlay>
      </li>
    </comps>
    <designationCategory>Furniture</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Harvest maypole ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_HarvestMaypole</defName>
    <label>harvest maypole</label>
    <description>A tall carved pole hung with bright ribbons, raised in celebration of a good harvest. Colonists gather around it for parties, and anyone nearby feels a little harvest cheer (+6 mood).</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/HarvestMaypole</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.3,2.6)</drawSize>
      <drawOffset>(0,0,0.75)</drawOffset>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.25</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>12</Beauty>
    </statBases>
    <costList>
      <WoodLog>60</WoodLog>
    </costList>
    <comps>
      <li>
        <compClass>CompGatherSpot</compClass>
      </li>
      <li Class="CompProperties_CauseHediff_AoE">
        <hediff>Homesteader_NearMaypole</hediff>
        <range>7.9</range>
        <ignoreMechs>true</ignoreMechs>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowCauseHediffAoE</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <designationCategory>Joy</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsJoy</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_HomesteadComforts</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
