<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Make jerky ============ -->
  <RecipeDef>
    <defName>Homesteader_MakeJerky</defName>
    <label>make jerky</label>
    <description>Cut raw meat into thin strips and dry them into long-lasting jerky.</description>
    <jobString>Making jerky.</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
          <disallowedThingDefs>
            <li>Homesteader_SmokedMeat</li>
            <li>Homesteader_SaltedMeat</li>
            <li>Homesteader_SmokedFish</li>
            <li>Homesteader_SaltedFish</li>
          </disallowedThingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
      <disallowedThingDefs>
        <li>Homesteader_SmokedMeat</li>
        <li>Homesteader_SaltedMeat</li>
        <li>Homesteader_SmokedFish</li>
        <li>Homesteader_SaltedFish</li>
      </disallowedThingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
      <disallowedThingDefs>
        <li>Homesteader_SmokedMeat</li>
        <li>Homesteader_SaltedMeat</li>
        <li>Homesteader_SmokedFish</li>
        <li>Homesteader_SaltedFish</li>
        <li>Meat_Human</li>
      </disallowedThingDefs>
    </defaultIngredientFilter>
    <products>
      <Homesteader_Jerky>10</Homesteader_Jerky>
    </products>
    <workSkill>Cooking</workSkill>
  </RecipeDef>

