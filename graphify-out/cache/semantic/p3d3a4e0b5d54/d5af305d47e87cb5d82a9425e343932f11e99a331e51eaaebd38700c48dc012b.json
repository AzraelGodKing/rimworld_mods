{"nodes": [{"id": "docs_ideas_deep_colony_batch_d_batch_d", "label": "Deep Colony Batch D (family layer)", "file_type": "document", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opened because players asked for as much as possible from Batch C leftovers plus QoL, and because rivalry scan, deathbed, funeral spam and untreated-trauma grace had real bugs; shipped across stamps batch-d-v1 through family-echo-v1."}, {"id": "docs_ideas_deep_colony_batch_d_fixes", "label": "Batch D shipped fixes", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rivalry pair scan became interval-gated (2500 ticks) with a reused scratch list for cost, deathbed limited to player-side pairs, funeral messages only when loss was actually eased, and the untreated-trauma grace restarts after counseling."}, {"id": "docs_ideas_deep_colony_batch_d_d16", "label": "D16 family tree inspect tab", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clickable relatives jump to that pawn, dead included, reachable from both the Character inspect tab and the Bio card."}, {"id": "docs_ideas_deep_colony_batch_d_d17", "label": "D17 kin join / defect", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weighted by relation (spouse 1.00 down to grandparent 0.30) with ex-lover/ex-spouse at 0% for this path; hostile raid kin defect with the vanilla goodwill hit while neutral/allied kin join free, rolled once per pawn and skipping leaders, lodgers, prisoners and babies."}, {"id": "docs_ideas_deep_colony_batch_d_d18", "label": "D18 ex-lovers reconcile (toxic on 4th)", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept separate from D17 so exes reconcile rather than defect; after more than 3 reunions both gain DC_Trauma_ToxicRelationship, and Date Night still owns romance schedules."}, {"id": "docs_ideas_deep_colony_batch_d_d19", "label": "D19 unwavering prisoners broken by family only", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires KinWeight > 0 (so not ex-lovers) plus mutual opinion, chance scaling with closeness; non-family still cannot, preserving the vanilla unwavering wall."}, {"id": "docs_ideas_deep_colony_batch_d_kinweight", "label": "KinWeight relation weighting", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_deep_colony_batch_d_d22", "label": "D22 kin died on the other side", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fires on Pawn.Kill for non-colonist victims, skips while an execution is in progress, and does not replace the opinion>=40 violent-loss trauma."}, {"id": "docs_ideas_deep_colony_batch_d_d24", "label": "D24 execute family", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Harmony prefix/postfix on ExecutionUtility.DoExecutionByCut with a ThreadStatic flag so the Kill path does not also fire D22."}, {"id": "docs_ideas_deep_colony_batch_d_e01", "label": "E01 grandchild born", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_deep_colony_batch_d_e02", "label": "E02 kin taken / returned", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately not a Nemesis hunt: kidnap or enemy capture gives a thought and letter that clears on rescue, recruit or return, deduped over 2500 ticks."}, {"id": "docs_ideas_deep_colony_batch_d_e04", "label": "E04 last of the line / line continues", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gated on a sawColonyBloodKin flag so starting pawns with no family never qualify; only blood kin count (spouse/lover excluded) and caravan or other-map kin still count as alive."}, {"id": "docs_ideas_deep_colony_batch_d_e08", "label": "E08 tradition teach", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ideas_deep_colony_batch_d_e10", "label": "E10 empty nest", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly the inverse of D21 homecoming: fires only when every living child is off the home map, with carried babies and pocket floors still counting as home."}, {"id": "docs_ideas_deep_colony_batch_d_enablefamilyjoin", "label": "enableFamilyJoin settings toggle", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One toggle covers the whole family-beats cluster, with Soft raising join chances and slowing reconcile while Hard does the opposite."}, {"id": "docs_ideas_deep_colony_batch_d_d13", "label": "D13 Strata gas / firestorm keyed reasons", "file_type": "concept", "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fail-open: adds keyed reasons onto existing toxic/fire trauma rather than new TraumaDefs, so it no-ops when Strata is absent."}], "edges": [{"source": "docs_ideas_deep_colony_batch_c_dc_c01", "target": "docs_ideas_deep_colony_batch_d_fixes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_deep_colony_batch_c_dc_c12", "target": "docs_ideas_deep_colony_batch_d_fixes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_deep_colony_batch_c_dc_c18", "target": "docs_ideas_deep_colony_batch_d_batch_d", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_deep_colony_batch_c_dc_c15", "target": "docs_ideas_deep_colony_batch_d_batch_d", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ideas/deep-colony-batch-d.md", "source_location": null, "weight": 1.0}, {"source": "docs_ideas_deep_colony_batch_d_d13", "target": "strata_steamdescription_atmosphere_sim", "relation": "references", "confidence": "AMBIGUOUS", "confidence_score": 0.3, "sou