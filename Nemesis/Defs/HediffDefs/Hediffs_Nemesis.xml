<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Captain progression armor — severity tracks progressionLevel (1–8). -->
  <HediffDef>
    <defName>Nemesis_BattleHardened</defName>
    <label>battle-hardened</label>
    <description>Scar tissue and hard-won grit from surviving the colony again and again. Softens blows that would drop a lesser raider.</description>
    <hediffClass>Hediff</hediffClass>
    <defaultLabelColor>(0.55, 0.32, 0.55)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <tendable>false</tendable>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>8</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>0.03</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.03</ArmorRating_Blunt>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.05</ArmorRating_Blunt>
        </statOffsets>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>0.07</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.07</ArmorRating_Blunt>
        </statOffsets>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>0.09</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.09</ArmorRating_Blunt>
        </statOffsets>
      </li>
      <li>
        <minSeverity>5</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>0.11</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.11</ArmorRating_Blunt>
          <MoveSpeed>0.05</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>6</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>0.13</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.13</ArmorRating_Blunt>
          <MoveSpeed>0.08</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>7</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
          <MoveSpeed>0.10</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>8</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>0.18</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.18</ArmorRating_Blunt>
          <MoveSpeed>0.12</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
