<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Shoring pillar (2× column roof support) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_ShoringPillar</defName>
    <label>shoring pillar</label>
    <description>Stone you leave standing. It braces about twice the span of a vanilla column. A wide hall still wants several — one pillar does not hold a whole roof.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <drawSize>(0.5,1.25)</drawSize>
      <drawOffset>(0,0,0.2)</drawOffset>
      <texPath>Things/Building/Furniture/Column</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shadowData>
        <volume>(0.3, 0.5, 0.3)</volume>
        <offset>(0,0,-0.23)</offset>
      </shadowData>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>0</pathCost>
    <fillPercent>0.25</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <uiIconScale>1.2</uiIconScale>
    <holdsRoof>true</holdsRoof>
    <specialDisplayRadius>13.8</specialDisplayRadius>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>25</costStuffCount>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>1400</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Beauty>3</Beauty>
    </statBases>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="Strata.CompProperties_Shoring">
        <protectionRadius>13.8</protectionRadius>
      </li>
    </comps>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Strata_Shoring</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Gas airlock ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_GasAirlock</defName>
    <label>gas airlock</label>
    <description>A sealed wall piece. On, rooms stop mixing air and people still walk through. Off, it is a hole. Use it to keep a poison pocket where it is.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/GasAirlock</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Flammability>0.3</Flammability>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Flickable"/>
      <li Class="Strata.CompProperties_GasAirlock"/>
    </comps>
    <building>
      <canPlaceOverWall>true</canPlaceOverWall>
    </building>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Strata_DeepInfrastructure</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Ore skip hoist ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_OreHoist</defName>
    <label>ore skip hoist</label>
    <description>A powered skip for chunks and slag. Build within five tiles of stairs or an elevator; the other landing grows a matching skip and they talk to each other.</description>
    <thingClass>Strata.Building_OreHoist</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/OreHoist</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>3500</WorkToBuild>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="Strata.CompProperties_OreHoist"/>
    </comps>
    <designationCategory>Misc</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Strata_DeepInfrastructure</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_Dumbwaiter</defName>
    <label>dumbwaiter</label>
    <description>One-tile hatch. Food, medicine, stacks — not people. Five tiles of stairs or elevator, matching hatch on the other floor. No power. Slower than the ore skip.</description>
    <thingClass>Strata.Building_OreHoist</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/CargoLift</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <fillPercent>0.3</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <WoodLog>40</WoodLog>
      <Steel>15</Steel>
    </costList>
    <comps>
      <li Class="Strata.CompProperties_OreHoist">
        <transferIntervalTicks>600</transferIntervalTicks>
        <pickupRadius>5</pickupRadius>
        <maxItemsPerTransfer>2</maxItemsPerTransfer>
        <chunksOnly>false</chunksOnly>
      </li>
    </comps>
    <designationCategory>Misc</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Strata_FreightLift</defName>
    <label>freight lift</label>
    <description>Powered goods shaft. Faster than the dumbwaiter; still no passengers. Stormproof brownout slows the cycle before it dies. Five tiles of stairs or elevator.</description>
    <thingClass>Strata.Building_OreHoist</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/OreHoist</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>35</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Flammability>0.35</Flammability>
    </statBases>
    <costList>
      <Steel>90</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>280</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="Strata.CompProperties_OreHoist">
        <transferIntervalTicks>180</transferIntervalTicks>
        <pickupRadius>6</pickupRadius>
        <maxItemsPerTransfer>8</maxItemsPerTransfer>
