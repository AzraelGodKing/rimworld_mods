<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Walkable/buildable pad on A+: only where the floor below is roofed.
       dontRender: SectionLayer_GroundBelow paints the real terrain from below
       (marble/slate/floors) so pads aren't white concrete. Selection stays local. -->
  <TerrainDef>
    <defName>Strata_RoofDeck</defName>
    <label>roof deck</label>
    <description>Framing over a roof on the floor below. You can walk and build here — the pad shows the flooring/terrain underneath. Look down through open-sky gaps at the roof edge for a live view. Expand roofs downstairs to grow this deck.</description>
    <texturePath>Terrain/Surfaces/Concrete</texturePath>
    <dontRender>true</dontRender>
    <edgeType>Hard</edgeType>
    <renderPrecedence>351</renderPrecedence>
    <pathCost>0</pathCost>
    <fertility>0</fertility>
    <passability>Standable</passability>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Walkable</li>
    </affordances>
    <tags>
      <li>Floor</li>
    </tags>
  </TerrainDef>

  <!-- Void cells: impassable hole — see the map below through these gaps. -->
  <TerrainDef>
    <defName>Strata_OpenSky</defName>
    <label>open sky</label>
    <description>Empty air over the floor below. You can look down through these gaps to the map underneath. Roof the floor below to extend the deck into this space.</description>
    <texturePath>Terrain/Surfaces/SoftSand</texturePath>
    <color>(0.14, 0.18, 0.32, 1)</color>
    <dontRender>true</dontRender>
    <edgeType>Hard</edgeType>
    <renderPrecedence>50</renderPrecedence>
    <pathCost>10000</pathCost>
    <fertility>0</fertility>
    <passability>Impassable</passability>
    <takeFootprints>false</takeFootprints>
    <burnedDef>Strata_OpenSky</burnedDef>
  </TerrainDef>

</Defs>
