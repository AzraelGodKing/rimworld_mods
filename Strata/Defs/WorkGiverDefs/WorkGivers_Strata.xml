<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <WorkGiverDef>
    <defName>Strata_HaulAcrossLevels</defName>
    <label>haul things to other levels</label>
    <giverClass>Strata.WorkGiver_HaulAcrossLevels</giverClass>
    <workType>Hauling</workType>
    <verb>haul</verb>
    <gerund>hauling</gerund>
    <!-- Just above HaulGeneral (15): a strictly better stockpile on another
         level must win before normal hauling parks the item locally. -->
    <priorityInType>16</priorityInType>
    <!-- Never in right-click orders: this giver shares vanilla hauling's
         "hauling" label and, evaluated first, would shadow the normal
         prioritize-haul option (reported as "can't force haul dead bodies").
         Forced hauls stay local and vanilla; cross-level moves are automatic. -->
    <directOrderable>false</directOrderable>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
