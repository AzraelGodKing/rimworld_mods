<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ── Shared base for all perk hediffs ────────────────────────────────────── -->
  <HediffDef Name="DC_PerkHediffBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1</maxSeverity>
  </HediffDef>

  <!-- ═══════════════════════════════════════════════════════════════════
       SHOOTING
  ══════════════════════════════════════════════════════════════════════ -->
  <HediffDef ParentName="DC_PerkHediffBase">
    <defName>DC_PerkHediff_PracticedEye</defName>
    <label>practiced eye</label>
    <description>Trained shooting eye — improved accuracy.</description>
    <stages>
      <li>
        <label>active</label>
        <statOffsets>
          <ShootingAccuracyPawn>0.04</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="DC_PerkHediffBase">
    <defName>DC_PerkHediff_CrackShot</defName>
    <label>crack shot</label>
    <description>Master-level shooting precision.</description>
    <stages>
      <li>
        <label>active</label>
        <statOffsets>
          <ShootingAccuracyPawn>0.09</ShootingAccuracyPawn>
        </statOffsets>
        <statFactors>
          <AimingDelayFactor>0.85</AimingDelayFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- ═══════════════════════════════════════════════════════════════════
       MELEE
  ══════════════════════════════════════════════════════════════════════ -->
  <HediffDef ParentName="DC_PerkHediffBase">
    <defName>DC_PerkHediff_BrawlersInstinct</defName>
    <label>brawler's instinct</label>
    <description>Sharper reflexes in close combat.</description>
    <stages>
      <li>
        <label>active</label>
        <statOffsets>
          <MeleeHitChance>0.04</MeleeHitChance>
          <MeleeDodgeChance>0.03</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="DC_PerkHediffBase">
    <defName>DC_PerkHediff_BattleHardened</defName>
    <label>battle hardened</label>
    <description>Veteran combat instincts.</description>
    <stages>
      <li>
        <label>active</label>
        <statOffsets>
          <MeleeHitChance>0.08</MeleeHitChance>
          <MeleeDodgeChance>0.06</MeleeDodgeChance>
          <PainShockThreshold>0.08</PainShockThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

