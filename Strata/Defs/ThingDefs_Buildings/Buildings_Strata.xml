  <!-- ============ Shaft power conduit ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_ShaftConduit</defName>
    <label>shaft power conduit</label>
    <description>An optional power junction for running power through a shaft. Build one within a few tiles of a stairwell or elevator: it automatically extends a matching junction down to the landing below, and power flows between the two grids once each level is wired to its junction — active as soon as it is built and wired, no switch to flip. Stairwells and elevators already carry power on their own — use this when you need a dedicated tie point away from the shaft footprint.</description>
    <thingClass>Strata.Building_ShaftConduit</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/ShaftConduit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>14</pathCost>
    <fillPercent>0.3</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>Strata.CompPowerShaft</compClass>
        <basePowerConsumption>10</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Strata_ShaftPower</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Oxygen pump (life support) ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_OxygenPump</defName>
    <label>oxygen pump</label>
    <description>A powered air enricher for sealed underground rooms. While running it slowly releases breathable oxygen into the room — enough to offset a few colonists, but not a substitute for shaft ventilation on a busy level.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/OxygenPump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>14</pathCost>
    <fillPercent>0.25</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="Strata.CompProperties_Exhaust">
        <gas>Strata_Oxygen</gas>
        <emissionPerCycle>0.008</emissionPerCycle>
        <emitWhenPowered>true</emitWhenPowered>
