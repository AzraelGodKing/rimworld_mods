<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <WorkGiverDef>
    <defName>Strata_HaulAcrossLevels</defName>
    <label>haul things to other levels</label>
    <giverClass>Strata.WorkGiver_HaulAcrossLevels</giverClass>
    <workType>Hauling</workType>
    <!-- Distinct verb/gerund matter: the right-click menu dedups options by
         label, so with vanilla's plain "hauling" this option would SHADOW the
         normal prioritize-haul (reported as "can't force haul dead bodies").
         With its own wording, both options coexist - local haul stays vanilla,
         and this one appears whenever a better level wants the item. -->
    <verb>haul to another level</verb>
    <gerund>hauling to another level:</gerund>
    <!-- Just above HaulGeneral (15): a strictly better stockpile on another
         level must win before normal hauling parks the item locally. -->
    <priorityInType>16</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>Strata_InstallAcrossLevels</defName>
    <label>install buildings on other levels</label>
    <giverClass>Strata.WorkGiver_InstallAcrossLevels</giverClass>
    <workType>Hauling</workType>
    <verb>install on another level</verb>
    <gerund>installing on another level:</gerund>
    <!-- Above HaulAcrossLevels (16): a waiting Blueprint_Install should win
         over generic cross-level stockpile pulls for the same minified. -->
    <priorityInType>17</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>Strata_BringBabyToCribAcrossLevels</defName>
    <label>bring babies to cribs on other levels</label>
    <giverClass>Strata.WorkGiver_BringBabyToCribAcrossLevels</giverClass>
    <workType>Childcare</workType>
    <verb>carry to crib on another level</verb>
    <gerund>carrying to crib on another level:</gerund>
    <!-- Above BringBabyToSafety (200): assigned cross-level cribs beat
         same-map "safe temperature" parking when the crib is upstairs. -->
    <priorityInType>210</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>Strata_BringPrisonerToBedAcrossLevels</defName>
    <label>take prisoners to beds on other levels</label>
    <giverClass>Strata.WorkGiver_BringPrisonerToBedAcrossLevels</giverClass>
    <workType>Warden</workType>
    <!-- Distinct from vanilla "take to bed" so right-click prioritize
         does not shadow the same-map Warden option. -->
    <verb>take to bed on another level</verb>
    <gerund>taking to bed on another level:</gerund>
    <!-- Above TakePrisonerToBed (90). -->
    <priorityInType>95</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>Strata_RescueToBedAcrossLevels</defName>
    <label>rescue to beds on other levels</label>
    <giverClass>Strata.WorkGiver_RescueToBedAcrossLevels</giverClass>
    <workType>Doctor</workType>
    <!-- Distinct from vanilla "rescue" so prioritize does not shadow. -->
    <verb>rescue to another level</verb>
    <gerund>rescuing to another level:</gerund>
    <!-- Above RescueDowned (~110). -->
    <priorityInType>120</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

</Defs>
