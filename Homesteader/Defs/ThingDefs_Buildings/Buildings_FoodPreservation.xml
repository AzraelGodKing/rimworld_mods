<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============ Drying rack ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_DryingRack</defName>
    <label>drying rack</label>
    <description>A wooden rack for air-drying food. Raw meat can be dried into long-lasting jerky, fruit and vegetables into dried produce or fruit leather, and foraged fungus into dried mushrooms. Requires no power or research.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/DryingRack</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <size>(3,1)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>18</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>60</WoodLog>
    </costList>
    <recipes>
      <li>Homesteader_MakeJerky</li>
      <li>Homesteader_MakeDriedProduce</li>
      <li>Homesteader_MakeFruitLeather</li>
      <li>Homesteader_MakeDriedMushrooms</li>
      <li>Homesteader_MakePemmican</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

  <!-- ============ Curing rack ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_CuringRack</defName>
    <label>curing rack</label>
    <description>A slatted wooden rack for salting meat and fish, or chipping rock salt from stone chunks. Faster than smoking and needs no fuel.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/CuringRack</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <size>(2,1)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Mass>14</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <WoodLog>40</WoodLog>
    </costList>
    <recipes>
      <li>Homesteader_MakeRockSalt</li>
      <li>Homesteader_CureMeat</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_PrimitiveHomestead</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Smokehouse ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Homesteader_Smokehouse</defName>
    <label>smokehouse</label>
    <description>A wood-fired smoker. Raw meat and fish smoked here keep for around a month and can still be cooked into meals. Consumes wood as fuel while in use.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Homesteader/Buildings/Smokehouse</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <fillPercent>0.6</fillPercent>
    <rotatable>true</rotatable>
    <size>(3,1)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>1600</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <costList>
      <WoodLog>90</WoodLog>
      <Steel>20</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>40.0</fuelConsumptionRate>
        <fuelCapacity>30.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
    </comps>
    <recipes>
      <li>Homesteader_SmokeMeat</li>
      <li>Homesteader_SmokeCheese</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <designationCategory>Production</designationCategory>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Homesteader_PrimitiveHomestead</li>
    </researchPrerequisites>
  </ThingDef>

