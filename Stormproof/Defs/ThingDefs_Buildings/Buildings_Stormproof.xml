  <!-- ============ Armored conduit ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Stormproof_ArmoredConduit</defName>
    <label>armored conduit</label>
    <description>A power conduit sheathed in riveted steel plate. Fireproof and far tougher than standard conduit - the wiring of choice for killboxes and exterior walls.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Stormproof/Buildings/ArmoredConduit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>SmallWire</altitudeLayer>
    <passability>Standable</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <rotatable>false</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>70</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <drawStyleCategory>Conduits</drawStyleCategory>
    <costList>
      <Steel>3</Steel>
    </costList>
    <building>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTransmitter</compClass>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <designationCategory>Power</designationCategory>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Stormproof_StormProtection</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Storm capacitor bank ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Stormproof_StormCapacitor</defName>
    <label>storm capacitor bank</label>
    <description>A bank of heavy capacitors tuned to swallow the violent charge of a lightning strike. Only spire-caught lightning can fill it - the grid cannot charge it - but in return it never leaks a watt in storage, and "Zzzt!" surges can't touch it. When grid production falls short, it automatically discharges up to 2,000W to cover the deficit.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Stormproof/Buildings/StormCapacitor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <rotatable>true</rotatable>
    <size>(2,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <Plasteel>10</Plasteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>0</basePowerConsumption>
        <transmitsPower>false</transmitsPower>
      </li>
      <li Class="Stormproof.CompProperties_StormCapacitor">
        <storedEnergyMax>3000</storedEnergyMax>
        <maxDischargeWatts>2000</maxDischargeWatts>
      </li>
    </comps>
    <designationCategory>Power</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Stormproof_StormProtection</li>
      <li>Batteries</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ Weather forecaster ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Stormproof_WeatherForecaster</defName>
    <label>weather forecaster</label>
    <description>A barometric console that reads pressure fronts and static charge in the air. Its inspect panel shows how long the current weather will hold, it announces incoming thunderstorms so you can ready your spires, and it warns you an hour before the weather breaks.</description>
