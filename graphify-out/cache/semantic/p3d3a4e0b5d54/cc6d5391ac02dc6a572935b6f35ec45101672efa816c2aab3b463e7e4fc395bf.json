{"nodes": [{"id": "strata_about_changelog_strata_4", "label": "Strata 4.0.0 release", "file_type": "document", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ships for RimWorld 1.6 and 1.7 from one source so 1.6 colonies keep getting updates and a Strata save carries to 1.7."}, {"id": "strata_about_changelog_magma_layer", "label": "Magma layer (bottom of the world)", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hard floor at B3 (B8 with Unlimited levels) gated behind deep bore research: 52C rock forces cooling, magma pools give light and fire risk, and a geothermal tap on a vent pays 6000 W for that cost."}, {"id": "strata_about_changelog_flooded_levels", "label": "Flooded levels", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An underground lake seeps across a level unless a powered sump pump runs there, spreads faster during heavy surface rain, and can drown downed or sleeping pawns; opt out via Special levels."}, {"id": "strata_about_changelog_lost_floors", "label": "Lost floors", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sealed rooms from earlier diggers carry loot, remains and nesting insects, and their diaries teach the mechanic lesson that mining noise underground draws infestations."}, {"id": "strata_about_changelog_walk_distance_routing", "label": "Walk-distance floor and stairwell choice", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routing switched from counting stairwells to measuring how far a pawn actually walks on intervening floors (walls, doors, slow ground), so unreachable stairs are skipped and aligned shafts win over nearer but costlier ones."}, {"id": "strata_about_changelog_drafted_multi_floor_orders", "label": "Drafted orders across several floors", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "strata_about_changelog_settings_presets", "label": "Settings presets, tabs and search", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Performance / Balanced / Immersive presets set the costly options in one click and flip to Custom on any manual change, so players can tune cost without understanding each option."}, {"id": "strata_about_changelog_modder_api_v2", "label": "Modder API v2", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "strata_about_changelog_storm_surge", "label": "Storms reach underground (Stormproof soft-compat)", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With Stormproof 2 loaded, surface rain, thunderstorms and ion storms enlarge seep floods on unpumped levels and the seismograph surfaces weather plus storm surge; build stamp storm-surge-v1."}, {"id": "strata_about_changelog_1_7_shaders", "label": "RimWorld 1.7 shader look", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1.7 gets Strata's own shaders (drifting gas blending, soft hole edges, depth vignette, shimmering underground water) with the vignette and water light switchable; 1.6 is left visually unchanged."}, {"id": "strata_about_changelog_net10_build", "label": "1.7 build on .NET 10", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "strata_about_changelog_save_carryover", "label": "3.8+ save carryover to 1.7", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strata reads every save field written by 3.8 and later, so the Strata part of a 1.6 save loads on 1.7; the rest depends on RimWorld and other mods, hence the backup warning."}, {"id": "strata_about_changelog_no_multiplayer", "label": "Strata is not Multiplayer compatible", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "strata_about_changelog_work_trip_idle_fix", "label": "Work-trip idle and stair-thrash fixes", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pawns sent cross-floor used to refuse all other work for up to half a day; now they take local work, abandon the trip after ~an hour, ignore a just-emptied floor until it gains real work, and back off dead-end detours."}, {"id": "strata_about_changelog_hidden_chamber_fix", "label": "Hidden chambers and rich ore seams placed after rock", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Geothermal/gas chambers and big ore seams were generated before the rock pass and got buried; ordering them after the rock fixes new levels while already-dug levels keep what they have."}, {"id": "strata_about_changelog_regression_tests", "label": "Regression tests for caves, deep oxygen and work choice", "file_type": "concept", "source_file": "Strata/About/changelog.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "strata_about_changelog_modder_api_v2", "target": "strata_api_stratamodderapi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_modder_api_v2", "target": "strata_api_apiversion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_strata_4", "target": "strata_about_changelog_magma_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_strata_4", "target": "strata_about_changelog_flooded_levels", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_strata_4", "target": "strata_about_changelog_lost_floors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_strata_4", "target": "strata_about_changelog_walk_distance_routing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_strata_4", "target": "strata_about_changelog_1_7_shaders", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_strata_4", "target": "strata_about_changelog_net10_build", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_strata_4", "target": "strata_about_changelog_save_carryover", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_strata_4", "target": "strata_about_changelog_settings_presets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_storm_surge", "target": "strata_about_changelog_flooded_levels", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_drafted_multi_floor_orders", "target": "strata_about_changelog_walk_distance_routing", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_walk_distance_routing", "target": "strata_api_travelcost", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "Strata/About/changelog.txt", "source_location": null, "weight": 1.0}, {"source": "strata_about_changelog_work_trip_idle_fix", "target": 