  <!-- ============ Shaft power conduit ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Strata_ShaftConduit</defName>
    <label>shaft power conduit</label>
    <description>An optional power junction for running power through a shaft. Build one within a few tiles of a stairwell or elevator: it automatically extends a matching junction down to the landing below, and power flows between the two grids once each level is wired to its junction — active as soon as it is built and wired, no switch to flip. Stairwells and elevators already carry power on their own — use this when you need a dedicated tie point away from the shaft footprint.</description>
    <thingClass>Strata.Building_ShaftConduit</thingClass>
    <graphicData>
      <texPath>Strata/Buildings/ShaftConduit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
