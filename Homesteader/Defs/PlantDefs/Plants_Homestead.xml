      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.55</fertilitySensitivity>
      <growDays>6</growDays>
      <sowMinSkill>4</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
